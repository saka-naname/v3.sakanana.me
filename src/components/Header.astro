---
import "../styles/globals.css";

import { Font } from "astro:assets";
import { Icon } from "astro-icon/components";

interface Props {
  variant?: "default" | "top";
}

const { variant = "default" } = Astro.props;
const pathname = Astro.url.pathname;

const navigation: Array<{ label: string; href: string }> = [
  { label: "About", href: "/about/" },
  { label: "Works", href: "/works/" },
  { label: "Notes", href: "/notes/" },
];

const internalNavigation = navigation.filter(({ href }) =>
  href.startsWith("/"),
);
const isCurrentPage = (href: string) =>
  href === "/" ? pathname === href : pathname.startsWith(href);

const socialLinks = [
  {
    label: "GitHub プロフィールを見る",
    href: "https://github.com/saka-naname",
    icon: "hugeicons:github-01",
  },
  {
    label: "Bluesky プロフィールを見る",
    href: "https://bsky.app/profile/sakanana.me",
    icon: "hugeicons:bluesky",
  },
  {
    label: "X プロフィールを見る",
    href: "https://x.com/sakanana_me",
    icon: "hugeicons:new-twitter",
  },
];
---

<head>
  <meta charset="utf-8" />
  <Font cssVariable="--font-kiyosuna-sans" />
  <Font cssVariable="--font-suse-mono" />
</head>

<header
  class:list={["header", "site-header", { "top-variant": variant === "top" }]}
  data-site-header
>
  <div class="container">
    <a class="logo" href="/">sakanana.me</a>
    <div class="desktop-menu">
      <nav aria-label="メインナビゲーション">
        <ul class="desktop-navigation">
          {
            internalNavigation.map(({ label, href }) => (
              <li>
                <a
                  href={href}
                  aria-current={isCurrentPage(href) ? "page" : undefined}
                >
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <span class="desktop-separator" aria-hidden="true"></span>

      <ul class="desktop-social-links" aria-label="ソーシャルリンク">
        {
          socialLinks.map(({ label, href, icon }) => (
            <li>
              <a href={href} aria-label={label}>
                <Icon name={icon} aria-hidden="true" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <button
      class="menu-button"
      type="button"
      aria-label="メニューを開く"
      aria-controls="mobile-menu"
      aria-expanded="false"
      data-menu-open
    >
      <span class="menu-icon" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
      </span>
    </button>
  </div>
</header>

<dialog
  id="mobile-menu"
  class="mobile-menu"
  aria-labelledby="mobile-menu-title"
  data-state="closed"
>
  <h2 id="mobile-menu-title" class="visually-hidden">メインメニュー</h2>

  <div class="header dialog-header">
    <div class="container">
      <a class="logo" href="/">sakanana.me</a>
      <button
        class="menu-button"
        type="button"
        aria-label="メニューを閉じる"
        data-menu-close
      >
        <span class="menu-icon" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </span>
      </button>
    </div>
  </div>

  <div class="drawer-layout">
    <button
      class="drawer-scrim"
      type="button"
      aria-label="メニューを閉じる"
      tabindex="-1"
      data-menu-close></button>

    <div class="drawer-panel">
      <nav aria-label="メインナビゲーション">
        <ul class="navigation">
          {
            navigation.map(({ label, href }) => (
              <li>
                <a
                  href={href}
                  aria-current={isCurrentPage(href) ? "page" : undefined}
                >
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <ul class="social-links" aria-label="ソーシャルリンク">
        {
          socialLinks.map(({ label, href, icon }) => (
            <li>
              <a href={href} aria-label={label}>
                <Icon name={icon} aria-hidden="true" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</dialog>

<div class:list={["margin", { "margin-disabled": variant === "top" }]}></div>

<style>
  .header {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 72px;
    border-bottom: 1px solid transparent;
  }

  .site-header {
    position: fixed;
    top: 0;
    z-index: 10;
    background-color: color-mix(
      in srgb,
      var(--color-background) 90%,
      transparent
    );
    backdrop-filter: blur(6px);
    transition:
      background-color 0.2s ease-out,
      border-bottom-color 0.2s ease-out,
      backdrop-filter 0.2s ease-out;

    &.top-variant {
      background-color: transparent;
      backdrop-filter: blur(0);
    }

    &.top-variant:not(.has-background, .menu-open) {
      --header-foreground: var(--color-surface);
      --header-foreground-hover: var(--color-surface);
      --header-separator: color-mix(
        in srgb,
        var(--color-surface) 30%,
        transparent
      );
    }

    &.top-variant:is(.has-background, .menu-open) {
      background-color: color-mix(
        in srgb,
        var(--color-background) 90%,
        transparent
      );
      backdrop-filter: blur(6px);
    }

    &.scrolled {
      border-bottom-color: color-mix(
        in srgb,
        var(--color-border) 20%,
        transparent
      );
    }
  }

  .container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: var(--container);
  }

  .logo {
    position: relative;
    display: inline-block;
    font-family: var(--font-kiyosuna-sans);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--header-foreground, var(--color-empress-dark-2));
    text-decoration: none;
    transition: color 0.2s ease-out;

    &::after {
      position: absolute;
      right: 0;
      bottom: -0.2em;
      left: 0;
      height: 1px;
      content: "";
      background-color: currentcolor;
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }

    &:is(:hover, :focus-visible)::after {
      transform: scaleX(1);
    }
  }

  .menu-button {
    display: none;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    font-size: 1.75rem;
    color: var(--color-text);
    cursor: pointer;
    background: transparent;
    border: 0;
    border-radius: 999px;

    &:is(:hover, :focus-visible) {
      background-color: color-mix(
        in srgb,
        var(--color-empress-light-1) 14%,
        transparent
      );
    }
  }

  .menu-icon {
    position: relative;
    display: block;
    width: 24px;
    height: 18px;
    color: var(--header-foreground, var(--color-empress-dark-2));
    transition: color 0.2s ease-out;

    span {
      position: absolute;
      left: 0;
      width: 24px;
      height: 2px;
      background-color: currentcolor;
      border-radius: 999px;
      transform-origin: center;
      transition:
        transform 0.24s cubic-bezier(0.16, 1, 0.3, 1),
        opacity 0.168s ease-out;
    }

    span:nth-child(1) {
      top: 1px;
    }

    span:nth-child(2) {
      top: 8px;
    }

    span:nth-child(3) {
      top: 15px;
    }
  }

  .mobile-menu[data-state="open"] .menu-icon {
    span:nth-child(1) {
      transform: translateY(7px) rotate(45deg);
    }

    span:nth-child(2) {
      opacity: 0;
      transform: scaleX(0);
    }

    span:nth-child(3) {
      transform: translateY(-7px) rotate(-45deg);
    }
  }

  .desktop-menu {
    display: flex;
    gap: 24px;
    align-items: center;
    padding: 0;
    margin-left: auto;
  }

  .desktop-navigation {
    display: flex;
    gap: 32px;
    align-items: center;
    justify-content: flex-end;
    padding: 0;
    margin: 0;
    list-style: none;

    a {
      position: relative;
      display: inline-block;
      font-family: var(--font-suse-mono);
      font-size: 0.9rem;
      color: var(--header-foreground, var(--color-empress-dark-2));
      text-transform: uppercase;
      letter-spacing: 0.12em;
      text-decoration: none;
      transition: color 0.2s ease-out;

      &::after {
        position: absolute;
        right: 0;
        bottom: -0.2em;
        left: 0;
        height: 1px;
        content: "";
        background-color: currentcolor;
        transform: scaleX(0);
        transform-origin: left;
        transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
      }

      &:is(:hover, :focus-visible, [aria-current="page"])::after {
        transform: scaleX(1);
      }
    }
  }

  .desktop-separator {
    width: 1px;
    height: 24px;
    margin-left: 6px;
    background-color: var(
      --header-separator,
      color-mix(in srgb, var(--color-empress-dark-1) 20%, transparent)
    );
    transition: background-color 0.2s ease-out;
  }

  .desktop-social-links {
    display: flex;
    gap: 4px;
    padding: 0;
    margin: 0;
    list-style: none;

    a {
      display: grid;
      place-items: center;
      width: 36px;
      height: 36px;
      font-size: 1.25rem;
      color: var(--header-foreground, var(--color-empress-dark-2));
      text-decoration: none;
      border-radius: 999px;
      transition: color 0.2s ease-out;

      &:is(:hover, :focus-visible) {
        color: var(--header-foreground-hover, var(--color-text));
        background-color: color-mix(
          in srgb,
          var(--color-empress-light-1) 14%,
          transparent
        );
      }
    }
  }

  .mobile-menu {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100dvh;
    max-height: none;
    padding: 0;
    margin: 0;
    overflow: hidden;
    color: var(--color-text);
    background: transparent;
    border: 0;

    &::backdrop {
      top: 72px;
      height: calc(100% - 72px);
      background-color: color-mix(in srgb, var(--color-text) 42%, transparent);
      opacity: 0;
      transition: opacity 0.336s ease-out;
    }
  }

  .dialog-header {
    position: relative;
    z-index: 2;
    background-color: var(--color-background);
    border-bottom-color: color-mix(
      in srgb,
      var(--color-border) 20%,
      transparent
    );
    transition:
      background-color 0.2s ease-out,
      border-bottom-color 0.2s ease-out;
  }

  .mobile-menu[data-state="closed"] .dialog-header {
    background-color: transparent;
    border-bottom-color: transparent;
  }

  .site-header.top-variant:not(.has-background, .menu-open)
    + .mobile-menu[data-state="closed"]
    .dialog-header {
    --header-foreground: var(--color-surface);
  }

  .drawer-layout {
    display: grid;
    grid-template-columns: minmax(48px, 1fr) min(76vw, 420px);
    height: calc(100dvh - 72px);
  }

  .drawer-scrim {
    padding: 0;
    cursor: pointer;
    background-color: transparent;
    border: 0;
  }

  .drawer-panel {
    display: flex;
    flex-direction: column;
    min-width: 0;
    overflow-y: auto;
    background-color: var(--color-background);
    border-left: 1px solid
      color-mix(in srgb, var(--color-border) 20%, transparent);
    transform: translateX(100%);
    transition: transform 0.336s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .mobile-menu[data-state="open"] {
    .drawer-panel {
      transform: translateX(0);
    }

    &::backdrop {
      opacity: 1;
    }
  }

  .drawer-panel nav {
    padding: 16px 28px;
  }

  .navigation,
  .social-links {
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .navigation {
    li {
      border-bottom: 1px solid var(--color-dessert-dark-2);
    }

    a {
      position: relative;
      display: flex;
      align-items: center;
      min-height: 76px;
      padding: 0 0 0 30px;
      font-family: var(--font-suse-mono);
      font-size: 1.15rem;
      color: var(--color-empress-light-1);
      text-transform: uppercase;
      letter-spacing: 0.18em;
      text-decoration: none;

      &::before {
        position: absolute;
        left: 0;
        width: 7px;
        height: 7px;
        content: "";
        background-color: currentcolor;
        border-radius: 50%;
        opacity: 0;
        transform: scale(0.5);
        transition:
          opacity 0.2s ease-out,
          transform 0.2s ease-out;
      }

      &:is(:hover, :focus-visible, [aria-current="page"]) {
        color: var(--color-text);

        &::before {
          opacity: 1;
          transform: scale(1);
        }
      }
    }
  }

  .social-links {
    display: flex;
    gap: 10px;
    padding: 18px 22px calc(18px + env(safe-area-inset-bottom));
    margin-top: auto;
    border-top: 1px solid var(--color-dessert-dark-2);

    a {
      display: grid;
      place-items: center;
      width: 44px;
      height: 44px;
      font-size: 1.5rem;
      color: var(--color-empress-light-1);
      text-decoration: none;
      border-radius: 999px;

      &:is(:hover, :focus-visible) {
        color: var(--color-text);
        background-color: color-mix(
          in srgb,
          var(--color-empress-light-1) 14%,
          transparent
        );
      }
    }
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    white-space: nowrap;
    border: 0;
    clip-path: inset(50%);
  }

  .margin {
    margin-bottom: 72px;
  }

  .margin-disabled {
    margin-bottom: 0;
  }

  @media (width < 768px) {
    .desktop-menu {
      display: none;
    }

    .menu-button {
      display: grid;
    }
  }

  @media (width < 420px) {
    .drawer-panel nav {
      padding: 12px 28px;
    }

    .navigation a {
      min-height: 68px;
      font-size: 1rem;
    }

    .social-links {
      padding-right: 22px;
      padding-left: 22px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .logo,
    .desktop-navigation a,
    .desktop-separator,
    .desktop-social-links a,
    .menu-icon,
    .desktop-navigation a::after,
    .drawer-panel,
    .mobile-menu::backdrop,
    .menu-icon span,
    .site-header,
    .dialog-header {
      transition-duration: 0.01ms;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>("[data-site-header]");
  const dialog = document.querySelector<HTMLDialogElement>("#mobile-menu");
  const openButton =
    document.querySelector<HTMLButtonElement>("[data-menu-open]");
  const closeButtons =
    dialog?.querySelectorAll<HTMLButtonElement>("[data-menu-close]");
  const scrollThreshold = 24;
  const closeDelay = window.matchMedia("(prefers-reduced-motion: reduce)")
    .matches
    ? 0
    : 336;
  let closeTimer: number | undefined;

  const updateHeader = () => {
    header?.classList.toggle("has-background", window.scrollY > 0);
    header?.classList.toggle("scrolled", window.scrollY >= scrollThreshold);
  };

  const openMenu = () => {
    if (!dialog || dialog.open) return;

    window.clearTimeout(closeTimer);
    dialog.showModal();
    openButton?.setAttribute("aria-expanded", "true");
    header?.classList.add("menu-open");
    document.documentElement.dataset.menuOpen = "";

    requestAnimationFrame(() => {
      dialog.dataset.state = "open";
    });
  };

  const closeMenu = (immediately = false) => {
    if (!dialog?.open) return;

    dialog.dataset.state = "closed";
    openButton?.setAttribute("aria-expanded", "false");
    header?.classList.remove("menu-open");
    delete document.documentElement.dataset.menuOpen;
    window.clearTimeout(closeTimer);

    closeTimer = window.setTimeout(
      () => dialog.close(),
      immediately ? 0 : closeDelay,
    );
  };

  updateHeader();
  window.addEventListener("scroll", updateHeader, { passive: true });
  openButton?.addEventListener("click", openMenu);
  closeButtons?.forEach((button) => {
    button.addEventListener("click", () => closeMenu());
  });
  dialog?.addEventListener("cancel", (event) => {
    event.preventDefault();
    closeMenu();
  });
  dialog?.addEventListener("close", () => {
    dialog.dataset.state = "closed";
    openButton?.setAttribute("aria-expanded", "false");
    header?.classList.remove("menu-open");
    delete document.documentElement.dataset.menuOpen;
  });
  window.matchMedia("(width >= 768px)").addEventListener("change", (event) => {
    if (event.matches) closeMenu(true);
  });
</script>

<style is:global>
  html[data-menu-open] {
    overflow: hidden;
  }
</style>
