---
import "../styles/globals.css";

import Font from "astro/components/Font.astro";
import { Icon } from "astro-icon/components";

const pathname = Astro.url.pathname;

const navigation = [
  { label: "Work", href: "/work/" },
  { label: "Illustration", href: "/illustration/" },
  { label: "Music", href: "/music/" },
  { label: "Blog", href: "https://v1.sakanana.me/blog" },
  { label: "About", href: "/about/" },
];

const socialLinks = [
  { label: "GitHub", href: "https://github.com/saka-naname" },
  { label: "Bluesky", href: "https://bsky.app/profile/sakanana.me" },
  { label: "Mail", href: "mailto:reisuicupsoup@gmail.com" },
];
---

<head>
  <meta charset="utf-8" />
  <Font cssVariable="--font-kiwi-maru" />
</head>

<header class="site-header" data-scroll-border>
  <div class="container">
    <a class="logo" href="/">sakanana.me</a>
    <button
      class="menu-button"
      type="button"
      aria-label="メニューを開く"
      aria-controls="mobile-menu"
      aria-expanded="false"
      data-menu-open
    >
      <Icon name="hugeicons:menu-01" aria-hidden="true" />
    </button>
  </div>
</header>

<dialog
  id="mobile-menu"
  class="mobile-menu"
  aria-labelledby="mobile-menu-title"
>
  <h2 id="mobile-menu-title" class="visually-hidden">メインメニュー</h2>

  <div class="dialog-header">
    <div class="container">
      <a class="logo" href="/">sakanana.me</a>
      <button
        class="menu-button"
        type="button"
        aria-label="メニューを閉じる"
        data-menu-close
      >
        <Icon name="hugeicons:cancel-01" aria-hidden="true" />
      </button>
    </div>
  </div>

  <div class="drawer-layout">
    <button
      class="drawer-scrim"
      type="button"
      aria-label="メニューを閉じる"
      tabindex="-1"
      data-menu-close></button>

    <div class="drawer-panel">
      <nav aria-label="メインナビゲーション">
        <ul class="navigation">
          {
            navigation.map(({ label, href }) => (
              <li>
                <a
                  href={href}
                  aria-current={pathname === href ? "page" : undefined}
                >
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <ul class="social-links" aria-label="ソーシャルリンク">
        {
          socialLinks.map(({ label, href }) => (
            <li>
              <a href={href}>{label}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</dialog>

<div class="margin"></div>

<style>
  .site-header,
  .dialog-header {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 72px;
    background-color: color-mix(
      in srgb,
      var(--color-background) 90%,
      transparent
    );
    border-bottom: 1px solid transparent;
    backdrop-filter: blur(6px);
  }

  .site-header {
    position: fixed;
    top: 0;
    z-index: 10;
    transition: border-bottom 0.2s ease-out;

    &.scrolled {
      border-bottom-color: color-mix(
        in srgb,
        var(--color-border) 20%,
        transparent
      );
    }
  }

  .container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: var(--container);
  }

  .logo {
    position: relative;
    display: inline-block;
    font-family: var(--font-kiwi-maru);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-empress-dark-2);
    text-decoration: none;

    &::after {
      position: absolute;
      right: 0;
      bottom: -0.2em;
      left: 0;
      height: 1px;
      content: "";
      background-color: var(--color-empress-dark-2);
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }

    &:is(:hover, :focus-visible)::after {
      transform: scaleX(1);
    }
  }

  .menu-button {
    display: none;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    font-size: 1.75rem;
    color: var(--color-text);
    cursor: pointer;
    background: transparent;
    border: 0;
    border-radius: 999px;

    &:is(:hover, :focus-visible) {
      background-color: color-mix(
        in srgb,
        var(--color-empress-light-1) 14%,
        transparent
      );
    }
  }

  .mobile-menu {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100dvh;
    max-height: none;
    padding: 0;
    margin: 0;
    overflow: hidden;
    color: var(--color-text);
    background: transparent;
    border: 0;

    &::backdrop {
      background: transparent;
    }
  }

  .dialog-header {
    position: relative;
    z-index: 2;
    border-bottom-color: color-mix(
      in srgb,
      var(--color-border) 20%,
      transparent
    );
  }

  .drawer-layout {
    display: grid;
    grid-template-columns: minmax(48px, 1fr) min(76vw, 420px);
    height: calc(100dvh - 72px);
  }

  .drawer-scrim {
    padding: 0;
    cursor: pointer;
    background-color: color-mix(in srgb, var(--color-text) 42%, transparent);
    border: 0;
    opacity: 0;
    transition: opacity 0.28s ease-out;
  }

  .drawer-panel {
    display: flex;
    flex-direction: column;
    min-width: 0;
    overflow-y: auto;
    background-color: var(--color-background);
    border-left: 1px solid
      color-mix(in srgb, var(--color-border) 20%, transparent);
    transform: translateX(100%);
    transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .mobile-menu[data-state="open"] {
    .drawer-scrim {
      opacity: 1;
    }

    .drawer-panel {
      transform: translateX(0);
    }
  }

  nav {
    padding: 16px 28px;
  }

  .navigation,
  .social-links {
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .navigation {
    li {
      border-bottom: 1px solid var(--color-dessert-dark-2);
    }

    a {
      position: relative;
      display: flex;
      align-items: center;
      min-height: 76px;
      padding: 0 0 0 30px;
      font-family: var(--font-suse-mono);
      font-size: 1.15rem;
      color: var(--color-empress-light-1);
      text-transform: uppercase;
      letter-spacing: 0.18em;
      text-decoration: none;

      &::before {
        position: absolute;
        left: 0;
        width: 7px;
        height: 7px;
        content: "";
        background-color: currentcolor;
        border-radius: 50%;
        opacity: 0;
        transform: scale(0.5);
        transition:
          opacity 0.2s ease-out,
          transform 0.2s ease-out;
      }

      &:is(:hover, :focus-visible, [aria-current="page"]) {
        color: var(--color-text);

        &::before {
          opacity: 1;
          transform: scale(1);
        }
      }
    }
  }

  .social-links {
    display: grid;
    gap: 18px;
    padding: 30px 40px calc(30px + env(safe-area-inset-bottom));
    margin-top: auto;
    border-top: 1px solid var(--color-dessert-dark-2);

    a {
      font-family: var(--font-suse-mono);
      font-size: 0.9rem;
      color: var(--color-empress-light-1);
      text-transform: uppercase;
      letter-spacing: 0.16em;
      text-decoration: none;

      &:is(:hover, :focus-visible) {
        color: var(--color-text);
        text-decoration: underline;
        text-underline-offset: 0.25em;
      }
    }
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    white-space: nowrap;
    border: 0;
    clip-path: inset(50%);
  }

  .margin {
    margin-bottom: 72px;
  }

  @media (width < 768px) {
    .menu-button {
      display: grid;
    }
  }

  @media (width < 420px) {
    nav {
      padding: 12px 28px;
    }

    .navigation a {
      min-height: 68px;
      font-size: 1rem;
    }

    .social-links {
      padding-right: 26px;
      padding-left: 26px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .drawer-scrim,
    .drawer-panel {
      transition-duration: 0.01ms;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>("[data-scroll-border]");
  const dialog = document.querySelector<HTMLDialogElement>("#mobile-menu");
  const openButton =
    document.querySelector<HTMLButtonElement>("[data-menu-open]");
  const closeButtons =
    dialog?.querySelectorAll<HTMLButtonElement>("[data-menu-close]");
  const scrollThreshold = 24;
  const closeDelay = window.matchMedia("(prefers-reduced-motion: reduce)")
    .matches
    ? 0
    : 280;
  let closeTimer: number | undefined;

  const updateHeaderBorder = () => {
    header?.classList.toggle("scrolled", window.scrollY >= scrollThreshold);
  };

  const openMenu = () => {
    if (!dialog || dialog.open) return;

    window.clearTimeout(closeTimer);
    dialog.showModal();
    openButton?.setAttribute("aria-expanded", "true");
    document.documentElement.dataset.menuOpen = "";

    requestAnimationFrame(() => {
      dialog.dataset.state = "open";
    });
  };

  const closeMenu = (immediately = false) => {
    if (!dialog?.open) return;

    dialog.dataset.state = "closed";
    openButton?.setAttribute("aria-expanded", "false");
    delete document.documentElement.dataset.menuOpen;
    window.clearTimeout(closeTimer);

    closeTimer = window.setTimeout(
      () => dialog.close(),
      immediately ? 0 : closeDelay,
    );
  };

  updateHeaderBorder();
  window.addEventListener("scroll", updateHeaderBorder, { passive: true });
  openButton?.addEventListener("click", openMenu);
  closeButtons?.forEach((button) => {
    button.addEventListener("click", () => closeMenu());
  });
  dialog?.addEventListener("cancel", (event) => {
    event.preventDefault();
    closeMenu();
  });
  dialog?.addEventListener("close", () => {
    dialog.dataset.state = "closed";
    openButton?.setAttribute("aria-expanded", "false");
    delete document.documentElement.dataset.menuOpen;
  });
  window.matchMedia("(width >= 768px)").addEventListener("change", (event) => {
    if (event.matches) closeMenu(true);
  });
</script>

<style is:global>
  html[data-menu-open] {
    overflow: hidden;
  }
</style>
