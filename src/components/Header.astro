---
import "../styles/globals.css";

import Font from "astro/components/Font.astro";
---

<head>
  <meta charset="utf-8" />
  <Font cssVariable="--font-kiwi-maru" />
</head>

<header data-scroll-border>
  <div class="container">
    <div class="logo">
      <a href="/">sakanana.me</a>
    </div>
    <div class="menu"></div>
  </div>
</header>
<div class="margin"></div>

<style>
  header {
    position: fixed;
    top: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100vw;
    height: 72px;
    background-color: color-mix(
      in srgb,
      var(--color-background) 90%,
      transparent
    );
    border-bottom: 1px solid transparent;
    backdrop-filter: blur(6px);
    transition: border-bottom 0.2s ease-out;

    &.scrolled {
      border-bottom: 1px solid
        color-mix(in srgb, var(--color-border) 20%, transparent);
    }
  }

  .container {
    display: flex;
    justify-content: space-between;
    width: var(--container);
  }

  .logo {
    a {
      position: relative;
      display: inline-block;
      font-family: var(--font-kiwi-maru);
      font-size: 1.25rem;
      font-weight: 700;
      color: var(--color-empress-dark-2);
      text-decoration: none;

      &::after {
        position: absolute;
        right: 0;
        bottom: -0.2em;
        left: 0;
        height: 1px;
        content: "";
        background-color: var(--color-empress-dark-2);
        transform: scaleX(0);
        transform-origin: left;
        transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
      }

      &:is(:hover, :focus-visible)::after {
        transform: scaleX(1);
      }
    }
  }

  .margin {
    margin-bottom: 72px;
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>("[data-scroll-border]");
  const scrollThreshold = 24;

  const updateHeaderBorder = () => {
    header?.classList.toggle("scrolled", window.scrollY >= scrollThreshold);
  };

  updateHeaderBorder();
  window.addEventListener("scroll", updateHeaderBorder, { passive: true });
</script>
