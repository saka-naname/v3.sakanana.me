---
import { formatNoteDate, noteCategoryLabels, type NoteEntry } from "./note";

interface Props {
  note: NoteEntry;
}

const { note } = Astro.props;
const { data } = note;
---

<article class="note-list-item" data-note-category={data.category}>
  <a href={`/notes/${data.slug}/`}>
    <div class="note-meta">
      <time datetime={data.publishedAt.toISOString()}>
        {formatNoteDate(data.publishedAt)}
      </time>
      <span>{noteCategoryLabels[data.category]}</span>
    </div>

    <div class="note-copy">
      <h3>{data.title}</h3>
      <p>{data.summary}</p>
    </div>
  </a>
</article>

<style>
  .note-list-item {
    border-bottom: 1px solid var(--color-dessert-dark-2);

    &[hidden] {
      display: none;
    }

    > a {
      display: grid;
      gap: 16px;
      padding-block: 28px;
      color: inherit;
      text-decoration: none;
    }
  }

  .note-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
    align-items: baseline;
    font-family: var(--font-suse-mono);
    font-size: 0.68rem;
    color: var(--color-empress-base);
    text-transform: uppercase;
    letter-spacing: 0.1em;

    > * {
      font-family: inherit;
    }

    span {
      color: var(--color-empress-dark-2);
    }
  }

  .note-copy {
    min-width: 0;

    h3 {
      margin: 0 0 8px;
      font-family: var(--font-kiyosuna-sans);
      font-size: clamp(1.3rem, 3vw, 1.65rem);
      font-weight: 700;
      line-height: 1.3;
      color: var(--color-empress-dark-2);
      text-underline-offset: 0.18em;
    }

    p {
      display: -webkit-box;
      margin: 0;
      overflow: hidden;
      -webkit-line-clamp: 2;
      font-size: 0.9rem;
      line-height: 1.75;
      color: var(--color-empress-dark-1);
      -webkit-box-orient: vertical;
    }
  }

  .note-list-item a:is(:hover, :focus-visible) h3 {
    color: var(--color-text);
    text-decoration: underline;
    text-decoration-thickness: 1px;
  }

  @media (width >= 680px) {
    .note-list-item > a {
      grid-template-columns: 168px minmax(0, 1fr);
      gap: 32px;
      padding-block: 32px;
    }

    .note-meta {
      display: grid;
      gap: 8px;
      align-content: start;
      font-size: 0.75rem;
    }

    .note-copy p {
      font-size: 0.95rem;
    }
  }
</style>
