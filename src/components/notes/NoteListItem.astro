---
import { formatNoteDate, noteCategoryLabels, type NoteEntry } from "./note";

interface Props {
  note: NoteEntry;
  variant?: "default" | "compact";
}

import { Icon } from "astro-icon/components";

const { note, variant = "default" } = Astro.props;
const { data } = note;
// PROTOTYPE (wayfinder #9)
const original = data.originalArticle;
---

<article
  class:list={["note-list-item", `variant-${variant}`]}
  data-note-category={data.category}
>
  <a
    href={`/notes/${data.slug}/`}
    data-proto-variant={original ? "N A B" : undefined}
  >
    <div class="note-meta">
      <time datetime={data.publishedAt.toISOString()}>
        {formatNoteDate(data.publishedAt)}
      </time>
      <span>{noteCategoryLabels[data.category]}</span>
      {
        original && (
          <span class="proto-a-label" data-proto-variant="A">
            {original.medium}
          </span>
        )
      }
    </div>

    <div class="note-copy">
      <h3>{data.title}</h3>
      <p>{data.summary}</p>
      {
        original && (
          <p class="proto-b-line" data-proto-variant="B">
            {original.medium} からの転載
          </p>
        )
      }
    </div>
  </a>
  {
    original && (
      <a href={original.url} rel="noopener" data-proto-variant="C">
        <div class="note-meta">
          <time datetime={data.publishedAt.toISOString()}>
            {formatNoteDate(data.publishedAt)}
          </time>
          <span>{noteCategoryLabels[data.category]}</span>
        </div>

        <div class="note-copy">
          <h3>
            {data.title}
            <span class="proto-c-medium">
              {original.medium}
              <Icon name="hugeicons:arrow-up-right-01" />
            </span>
          </h3>
          <p>{data.summary}</p>
        </div>
      </a>
    )
  }
</article>

<style>
  .note-list-item {
    border-bottom: 1px solid var(--color-dessert-dark-2);

    &[hidden] {
      display: none;
    }

    > a {
      display: grid;
      gap: 16px;
      padding-block: 28px;
      color: inherit;
      text-decoration: none;
    }
  }

  .note-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
    align-items: baseline;
    font-size: 0.75rem;
    color: var(--color-empress-base);
    text-transform: uppercase;
    letter-spacing: 0.1em;

    > * {
      font-family: inherit;
    }

    span {
      color: var(--color-empress-dark-2);
    }
  }

  .note-copy {
    min-width: 0;

    h3 {
      margin: 0 0 8px;
      font-family: var(--font-kiyosuna-sans);
      font-size: clamp(1.3rem, 3vw, 1.65rem);
      font-weight: 700;
      line-height: 1.3;
      color: var(--color-empress-dark-2);
      text-underline-offset: 0.18em;
    }

    p {
      display: -webkit-box;
      margin: 0;
      overflow: hidden;
      -webkit-line-clamp: 2;
      font-size: 0.9rem;
      line-height: 1.75;
      color: var(--color-empress-dark-1);
      -webkit-box-orient: vertical;
    }
  }

  /* PROTOTYPE (wayfinder #9) */
  .note-meta .proto-a-label {
    justify-self: start;
    padding: 1px 6px;
    color: var(--color-empress-dark-1);
    border: 1px solid var(--color-dessert-dark-3);
  }

  .note-copy .proto-b-line {
    display: block;
    margin-top: 8px;
    font-size: 0.78rem;
    color: var(--color-empress-base);
  }

  .proto-c-medium {
    display: inline-flex;
    gap: 0.15em;
    align-items: center;
    margin-left: 0.5em;
    font-size: 0.8rem;
    font-weight: 400;
    color: var(--color-empress-base);
    vertical-align: middle;
  }

  .variant-compact {
    > a {
      padding-block: 24px;
    }

    .note-copy h3 {
      font-size: clamp(1.2rem, 3vw, 1.45rem);
    }
  }

  .note-list-item a:is(:hover, :focus-visible) h3 {
    color: var(--color-text);
    text-decoration: underline;
    text-decoration-thickness: 1px;
  }

  @media (--breakpoint-sm) {
    .note-list-item > a {
      grid-template-columns: 168px minmax(0, 1fr);
      gap: 32px;
      padding-block: 32px;
    }

    .note-meta {
      display: grid;
      gap: 8px;
      align-content: start;
      font-size: 0.75rem;
    }

    .note-copy p {
      font-size: 0.95rem;
    }

    .variant-compact > a {
      grid-template-columns: 136px minmax(0, 1fr);
      gap: 24px;
      padding-block: 24px;
    }
  }
</style>
