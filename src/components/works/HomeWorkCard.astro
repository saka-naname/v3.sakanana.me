---
import { Image } from "astro:assets";

import { kindLabels, type WorkEntry } from "./work-card";

interface Props {
  work: WorkEntry;
  slideIndex: number;
  slideCount: number;
}

const { work, slideIndex, slideCount } = Astro.props;
const { data } = work;
---

<article
  class="home-work-item"
  data-home-work-slide
  aria-label={`${slideIndex + 1} / ${slideCount}`}
>
  <a href={`/works/${data.slug}/`}>
    <figure class="work-image">
      <Image
        src={data.images[0].image}
        alt={data.images[0].alt}
        widths={[360, 520, 720]}
        sizes="(min-width: 1288px) 292px, (min-width: 960px) calc((100vw - 120px) / 4), (min-width: 680px) calc((100vw - 72px) / 2), calc(100vw - 48px)"
        loading="lazy"
        layout="none"
      />
    </figure>

    <div class="work-copy">
      <p class="work-kind">{kindLabels[data.kind]}</p>
      <h3>{data.title}</h3>
      <p class="work-summary">{data.summary}</p>
    </div>
  </a>
</article>

<style>
  .home-work-item {
    flex: 0 0 100%;
    min-width: 0;
    scroll-snap-align: start;

    > a {
      display: block;
      height: 100%;
      color: inherit;
      text-decoration: none;
    }
  }

  .work-image {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--color-dessert-dark-1);
    border: 1px solid var(--color-dessert-dark-2);

    img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
    }
  }

  .work-copy {
    padding-top: 14px;

    h3 {
      display: -webkit-box;
      margin-bottom: 7px;
      overflow: hidden;
      -webkit-line-clamp: 1;
      font-family: var(--font-kiyosuna-sans);
      font-size: 1.3rem;
      font-weight: 700;
      line-height: 1.25;
      color: var(--color-empress-dark-2);
      text-underline-offset: 0.16em;
      -webkit-box-orient: vertical;
    }
  }

  .work-kind {
    margin-bottom: 7px;
    font-family: var(--font-suse-mono);
    font-size: 0.67rem;
    color: var(--color-empress-dark-2);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .work-summary {
    display: -webkit-box;
    overflow: hidden;
    -webkit-line-clamp: 2;
    font-size: 0.85rem;
    line-height: 1.7;
    color: var(--color-empress-dark-1);
    -webkit-box-orient: vertical;
  }

  .home-work-item a:is(:hover, :focus-visible) {
    h3 {
      color: var(--color-text);
      text-decoration: underline;
      text-decoration-thickness: 1px;
    }

    .work-image img {
      transform: scale(1.018);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .work-image img {
      transition: none;
    }
  }
</style>
