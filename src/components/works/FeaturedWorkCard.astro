---
import { Image } from "astro:assets";

import { formatPublishedDate, kindLabels, type WorkEntry } from "./work-card";

interface Props {
  work: WorkEntry;
  variant: "card" | "list";
  slideIndex: number;
  slideCount: number;
}

const { work, variant, slideIndex, slideCount } = Astro.props;
const { data } = work;
const url = `/works/${data.slug}/`;
---

<article
  class:list={["featured-item", `variant-${variant}`]}
  data-featured-slide
  aria-label={`${slideIndex + 1} / ${slideCount}`}
>
  <a class="featured-card" href={url}>
    <figure class="featured-image">
      <Image
        src={data.images[0].image}
        alt={data.images[0].alt}
        widths={[480, 720, 960]}
        sizes={variant === "card"
          ? "(min-width: 1288px) 720px, (min-width: 1024px) calc(100vw - 568px), (min-width: 688px) 640px, calc(100vw - 48px)"
          : "(min-width: 1024px) 200px, (min-width: 688px) 640px, calc(100vw - 48px)"}
        loading="eager"
        layout="none"
      />
    </figure>
    <div class="featured-copy">
      <div class="work-meta">
        <div class="work-labels">
          <span>{kindLabels[data.kind]}</span>
          {data.status === "wip" && <span class="work-status">WIP</span>}
        </div>
        <time datetime={data.publishedAt.toISOString()}>
          {formatPublishedDate(data.publishedAt)}
        </time>
      </div>
      <h3>{data.title}</h3>
      <p>{data.summary}</p>
      <ul class="tag-list" aria-label="タグ">
        {data.tags.slice(0, 3).map((tag) => <li>{tag}</li>)}
      </ul>
    </div>
  </a>
</article>

<style>
  .featured-item {
    flex: 0 0 100%;
    min-width: 0;
    scroll-snap-align: start;
  }

  .featured-card {
    display: block;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }

  .featured-image {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--color-dessert-dark-1);
    border: 1px solid var(--color-dessert-dark-2);

    img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
    }
  }

  .featured-copy {
    padding-top: 16px;

    h3 {
      display: -webkit-box;
      margin-bottom: 8px;
      overflow: hidden;
      -webkit-line-clamp: 1;
      font-family: var(--font-kiyosuna-sans);
      font-size: clamp(1.45rem, 6vw, 2rem);
      font-weight: 700;
      line-height: 1.25;
      color: var(--color-empress-dark-2);
      -webkit-box-orient: vertical;
    }

    p {
      display: -webkit-box;
      overflow: hidden;
      -webkit-line-clamp: 2;
      font-size: 0.88rem;
      line-height: 1.7;
      color: var(--color-empress-dark-1);
      -webkit-box-orient: vertical;
    }
  }

  .work-meta {
    display: flex;
    gap: 16px;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 8px;
    font-family: var(--font-suse-mono);
    font-size: 0.67rem;
    color: var(--color-empress-base);
    text-transform: uppercase;
    letter-spacing: 0.1em;

    > .work-labels > span:first-child {
      color: var(--color-empress-dark-2);
    }
  }

  .work-labels {
    display: flex;
    gap: 8px;
    align-items: center;
  }

  .work-status {
    padding: 1px 5px;
    color: var(--color-empress-dark-2);
    border: 1px solid var(--color-dessert-dark-3);
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 14px;
    padding: 12px 0 0;
    margin: 0;
    font-family: var(--font-suse-mono);
    font-size: 0.65rem;
    color: var(--color-empress-base);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    list-style: none;

    li::before {
      content: "#";
    }
  }

  @media (hover: hover) {
    .featured-card:hover {
      .featured-image img {
        transform: scale(1.018);
      }

      h3 {
        color: var(--color-text);
        text-decoration: underline;
        text-decoration-thickness: 1px;
        text-underline-offset: 0.16em;
      }
    }
  }

  @media (width >= 1024px) {
    .variant-card {
      grid-row: 1 / 4;
      grid-column: 1;
      align-self: stretch;
      contain: size;

      .featured-card {
        display: flex;
        flex-direction: column;
      }

      .featured-image {
        flex: none;
        aspect-ratio: 4 / 3;
      }

      .featured-copy h3 {
        font-size: clamp(2rem, 3.2vw, 2.75rem);
      }
    }

    .variant-list {
      grid-column: 2;

      .featured-card {
        display: grid;
        grid-template-columns: minmax(116px, 42%) minmax(0, 1fr);
        gap: 20px;
        align-items: start;
      }

      .featured-copy {
        display: flex;
        flex-direction: column;
        justify-content: center;
        height: 100%;
        padding-top: 0;

        h3 {
          font-size: clamp(1.2rem, 2vw, 1.55rem);
        }
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .featured-image img {
      transition: none;
    }
  }
</style>
