---
import { Image } from "astro:assets";

import { formatPublishedDate, kindLabels, type WorkEntry } from "./work-card";

interface Props {
  work: WorkEntry;
  loading?: "eager" | "lazy";
}

const { work, loading = "lazy" } = Astro.props;
const { data } = work;
const url = `/works/${data.slug}/`;
const Heading = "h3";
---

<article class="work-card" data-work-kind={data.kind}>
  <a href={url}>
    <figure class="work-image">
      <Image
        src={data.images[0].image}
        alt={data.images[0].alt}
        widths={[420, 640, 820]}
        sizes="(min-width: 1024px) 28vw, (min-width: 680px) 44vw, 92vw"
        loading={loading}
        layout="none"
      />
    </figure>
    <div class="work-copy">
      <div class="work-meta">
        <div class="work-labels">
          <span>{kindLabels[data.kind]}</span>
          {data.status === "wip" && <span class="work-status">WIP</span>}
        </div>
        <time datetime={data.publishedAt.toISOString()}>
          {formatPublishedDate(data.publishedAt)}
        </time>
      </div>
      <Heading>{data.title}</Heading>
      <p>{data.summary}</p>
      <ul class="tag-list" aria-label="タグ">
        {data.tags.slice(0, 3).map((tag) => <li>{tag}</li>)}
      </ul>
    </div>
  </a>
</article>

<style>
  .work-card {
    &[hidden] {
      display: none;
    }

    > a {
      display: block;
      height: 100%;
      color: inherit;
      text-decoration: none;
    }
  }

  .work-image {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--color-dessert-dark-1);
    border: 1px solid var(--color-dessert-dark-2);

    img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
    }
  }

  .work-copy {
    padding-top: 16px;

    h3 {
      display: -webkit-box;
      margin-bottom: 8px;
      overflow: hidden;
      -webkit-line-clamp: 1;
      font-family: var(--font-kiyosuna-sans);
      font-size: 1.45rem;
      font-weight: 700;
      line-height: 1.25;
      color: var(--color-empress-dark-2);
      -webkit-box-orient: vertical;
    }

    > p {
      display: -webkit-box;
      overflow: hidden;
      -webkit-line-clamp: 2;
      font-size: 0.88rem;
      line-height: 1.7;
      color: var(--color-empress-dark-1);
      -webkit-box-orient: vertical;
    }
  }

  .work-meta {
    display: flex;
    gap: 16px;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 8px;
    font-family: var(--font-suse-mono);
    font-size: 0.67rem;
    color: var(--color-empress-base);
    text-transform: uppercase;
    letter-spacing: 0.1em;

    > .work-labels > span:first-child {
      color: var(--color-empress-dark-2);
    }
  }

  .work-labels {
    display: flex;
    gap: 8px;
    align-items: center;
  }

  .work-status {
    padding: 1px 5px;
    color: var(--color-empress-dark-2);
    border: 1px solid var(--color-dessert-dark-3);
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 14px;
    padding: 12px 0 0;
    margin: 0;
    font-family: var(--font-suse-mono);
    font-size: 0.65rem;
    color: var(--color-empress-base);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    list-style: none;

    li::before {
      content: "#";
    }
  }

  @media (hover: hover) {
    .work-card a:hover {
      .work-image img {
        transform: scale(1.018);
      }

      h3 {
        color: var(--color-text);
        text-decoration: underline;
        text-decoration-thickness: 1px;
        text-underline-offset: 0.16em;
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .work-image img {
      transition: none;
    }
  }

  @media (width >= 960px) {
    .tag-list {
      font-size: 0.75rem;
    }

    .work-meta {
      font-size: 0.75rem;
    }
  }
</style>
