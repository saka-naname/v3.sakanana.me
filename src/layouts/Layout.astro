---
import "the-new-css-reset/css/reset.css";
import "../styles/globals.css";

import { Font } from "astro:assets";

import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";

interface Props {
  headerVariant?: "default" | "top";
  title?: string;
  description?: string;
  canonical?: string | URL;
  openGraphImage?: string | URL;
  openGraphType?: "website" | "article";
}

const {
  headerVariant = "default",
  title = "sakanana.me",
  description = "sakanana.me — 制作物や日々の記録をまとめています。",
  canonical,
  openGraphImage,
  openGraphType = "website",
} = Astro.props;

const canonicalUrl = String(
  canonical ?? new URL(Astro.url.pathname, Astro.site ?? Astro.url),
);
const openGraphImageUrl = openGraphImage ? String(openGraphImage) : undefined;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={openGraphType} />
    <meta property="og:url" content={canonicalUrl} />
    {
      openGraphImageUrl && (
        <meta property="og:image" content={openGraphImageUrl} />
      )
    }
    <meta
      name="twitter:card"
      content={openGraphImageUrl ? "summary_large_image" : "summary"}
    />
    <title>{title}</title>
    <Font
      cssVariable="--font-kiyosuna-sans"
      preload={[{ weight: 300 }, { weight: 700 }]}
    />
    <Font cssVariable="--font-zen-kaku-gothic-antique" />
    <Font cssVariable="--font-suse-mono" />
  </head>
  <body>
    <Header variant={headerVariant} />
    <div class="page-content">
      <slot />
    </div>
    <Footer />
  </body>
</html>

<style>
  body {
    display: flex;
    flex-direction: column;
    width: 100%;
    min-height: 100lvh;
    margin: 0;
    overflow-x: hidden;
    background-color: var(--color-background);
  }

  .page-content {
    flex: 1 0 auto;
    width: 100%;
    padding-bottom: 72px;
  }

  @media (width >= 768px) {
    .page-content {
      padding-bottom: 96px;
    }
  }
</style>

<style is:global>
  * {
    box-sizing: border-box;
    font-family: var(--font-zen-kaku-gothic-antique);
  }
</style>
