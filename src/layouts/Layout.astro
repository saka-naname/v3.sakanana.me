---
import { Font } from "astro:assets";

import Header from "../components/Header.astro";

interface Props {
  headerVariant?: "default" | "top";
}

const { headerVariant = "default" } = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>sakanana.me</title>
    <Font cssVariable="--font-zen-kaku-gothic-antique" />
    <Font cssVariable="--font-suse-mono" />
  </head>
  <body>
    <Header variant={headerVariant} />
    <slot />
  </body>
</html>

<style>
  html,
  body {
    width: 100%;
    height: 100%;
    margin: 0;
  }
</style>

<style is:global>
  * {
    font-family: var(--font-zen-kaku-gothic-antique);
  }
</style>
