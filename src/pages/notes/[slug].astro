---
import "../../styles/globals.css";

import type { GetStaticPaths } from "astro";
import { Font } from "astro:assets";
import { type CollectionEntry, getCollection, render } from "astro:content";
import { Icon } from "astro-icon/components";

import {
  compareNotesByPublishedAt,
  formatNoteDate,
  noteCategoryLabels,
  type NoteEntry,
} from "../../components/notes/note";
import RelatedWorkCard from "../../components/notes/RelatedWorkCard.astro";
import VideoEmbed from "../../components/works/VideoEmbed.astro";
import Layout from "../../layouts/Layout.astro";

type WorkEntry = CollectionEntry<"work">;

interface Props {
  note: NoteEntry;
  newerNote?: NoteEntry;
  olderNote?: NoteEntry;
  relatedWorks: WorkEntry[];
}

export const getStaticPaths = (async () => {
  const notes = (await getCollection("note", ({ data }) => !data.draft)).sort(
    compareNotesByPublishedAt,
  );
  const works = await getCollection("work");
  const workById = new Map(works.map((work) => [work.id, work]));

  const slugs = new Set<string>();
  for (const note of notes) {
    if (slugs.has(note.data.slug)) {
      throw new Error(`Duplicate note slug: ${note.data.slug}`);
    }
    slugs.add(note.data.slug);
  }

  return notes.map((note, index) => ({
    params: { slug: note.data.slug },
    props: {
      note,
      newerNote: notes[index - 1],
      olderNote: notes[index + 1],
      relatedWorks: note.data.relatedWorks
        .map(({ id }) => workById.get(id))
        .filter((work): work is WorkEntry => Boolean(work && !work.data.draft)),
    },
  }));
}) satisfies GetStaticPaths;

const { note, newerNote, olderNote, relatedWorks } = Astro.props;
const { data } = note;
const { Content } = await render(note);
const canonical = new URL(`/notes/${data.slug}/`, Astro.site ?? Astro.url);
const showUpdatedAt =
  data.updatedAt &&
  formatNoteDate(data.updatedAt) !== formatNoteDate(data.publishedAt);
---

<head>
  <meta charset="utf-8" />
  <Font cssVariable="--font-kiyosuna-sans" />
  <Font cssVariable="--font-suse-mono" />
</head>

<Layout
  title={`${data.title} | Notes | sakanana.me`}
  description={data.summary}
  canonical={canonical}
  openGraphType="article"
>
  <main class="note-detail">
    <a class="back-link" href="/notes/">NOTES</a>

    <header class="note-header">
      <div class="note-meta">
        <span class="category-label">
          {noteCategoryLabels[data.category]}
        </span>
        <span>
          PUBLISHED
          <time datetime={data.publishedAt.toISOString()}>
            {formatNoteDate(data.publishedAt)}
          </time>
        </span>
        {
          showUpdatedAt && data.updatedAt && (
            <span>
              UPDATED
              <time datetime={data.updatedAt.toISOString()}>
                {formatNoteDate(data.updatedAt)}
              </time>
            </span>
          )
        }
      </div>

      <h1>{data.title}</h1>
      <p>{data.summary}</p>

      {
        data.tags.length > 0 && (
          <ul class="tag-list" aria-label="タグ">
            {data.tags.map((tag) => (
              <li>{tag}</li>
            ))}
          </ul>
        )
      }
    </header>

    <article class="note-body" data-note-body>
      <Content components={{ VideoEmbed }} />
    </article>

    {
      relatedWorks.length > 0 && (
        <section class="related-works" aria-labelledby="related-works-title">
          <h2 id="related-works-title">RELATED WORKS</h2>
          <div>
            {relatedWorks.map((work) => (
              <RelatedWorkCard work={work} />
            ))}
          </div>
        </section>
      )
    }

    {
      (newerNote || olderNote) && (
        <nav class="note-navigation" aria-label="前後のNote">
          {newerNote ? (
            <a href={`/notes/${newerNote.data.slug}/`}>
              <span class="navigation-label">
                <Icon name="hugeicons:arrow-left-01" />
                <span>NEXT</span>
              </span>
              <strong>{newerNote.data.title}</strong>
            </a>
          ) : (
            <span aria-hidden="true" />
          )}
          {olderNote && (
            <a class="older-note" href={`/notes/${olderNote.data.slug}/`}>
              <span class="navigation-label">
                <span>PREV</span>
                <Icon name="hugeicons:arrow-right-01" />
              </span>
              <strong>{olderNote.data.title}</strong>
            </a>
          )}
        </nav>
      )
    }

    <p
      class="visually-hidden"
      data-copy-status
      aria-live="polite"
      aria-atomic="true"
    >
    </p>
  </main>
</Layout>

<script>
  const noteBody = document.querySelector<HTMLElement>("[data-note-body]");
  const copyStatus = document.querySelector<HTMLElement>("[data-copy-status]");

  noteBody
    ?.querySelectorAll<HTMLHeadingElement>("h2[id], h3[id], h4[id]")
    .forEach((heading) => {
      if (heading.querySelector(".heading-anchor")) return;

      const label = heading.textContent?.trim() ?? "見出し";
      const anchor = document.createElement("a");
      heading.setAttribute("aria-label", label);
      anchor.className = "heading-anchor";
      anchor.href = `#${heading.id}`;
      anchor.setAttribute("aria-label", `「${label}」へのリンク`);
      anchor.textContent = "#";
      heading.prepend(anchor);
    });

  const writeToClipboard = async (text: string) => {
    if (navigator.clipboard?.writeText) {
      await navigator.clipboard.writeText(text);
      return;
    }

    const textarea = document.createElement("textarea");
    textarea.value = text;
    textarea.setAttribute("readonly", "");
    textarea.style.position = "fixed";
    textarea.style.opacity = "0";
    document.body.append(textarea);
    textarea.select();
    document.execCommand("copy");
    textarea.remove();
  };

  noteBody?.querySelectorAll<HTMLPreElement>("pre").forEach((pre) => {
    const code = pre.querySelector("code");
    if (!code || pre.querySelector(".code-copy-button")) return;

    const button = document.createElement("button");
    button.className = "code-copy-button";
    button.type = "button";
    button.setAttribute("aria-label", "コードをコピー");
    button.innerHTML = `
      <svg class="copy-icon" viewBox="0 0 24 24" aria-hidden="true">
        <rect x="8" y="8" width="11" height="11" rx="1"></rect>
        <path d="M16 8V5H5v11h3"></path>
      </svg>
      <svg class="check-icon" viewBox="0 0 24 24" aria-hidden="true">
        <path d="m5 12 4 4L19 6"></path>
      </svg>
    `;

    let resetTimer: number | undefined;
    button.addEventListener("click", async () => {
      try {
        await writeToClipboard(code.textContent ?? "");
        button.dataset.copied = "true";
        button.setAttribute("aria-label", "コピーしました");
        if (copyStatus) copyStatus.textContent = "コードをコピーしました。";

        window.clearTimeout(resetTimer);
        resetTimer = window.setTimeout(() => {
          delete button.dataset.copied;
          button.setAttribute("aria-label", "コードをコピー");
        }, 1800);
      } catch {
        if (copyStatus)
          copyStatus.textContent = "コードをコピーできませんでした。";
      }
    });

    pre.append(button);
  });
</script>

<style>
  .note-detail {
    width: var(--container);
    padding-bottom: 64px;
    margin-inline: auto;
  }

  .back-link {
    display: inline-flex;
    margin-top: 0.25rem;
    font-family: var(--font-kiyosuna-sans);
    font-size: 2rem;
    font-weight: 700;
    color: var(--color-empress-base);
    text-underline-offset: 0.22em;

    &:is(:hover, :focus-visible) {
      color: var(--color-text);
    }
  }

  .note-header,
  .note-body,
  .related-works,
  .note-navigation {
    width: min(100%, 760px);
    margin-inline: auto;
  }

  .note-header {
    margin-top: 40px;

    h1 {
      margin-top: 14px;
      font-family: var(--font-kiyosuna-sans);
      font-size: clamp(2.15rem, 7vw, 3.75rem);
      font-weight: 700;
      line-height: 1.15;
      color: var(--color-empress-dark-2);
      letter-spacing: -0.015em;
    }

    > p {
      margin-top: 24px;
      font-size: clamp(0.95rem, 2vw, 1.12rem);
      line-height: 1.85;
      color: var(--color-empress-dark-1);
    }
  }

  .note-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
    align-items: baseline;
    font-family: var(--font-suse-mono);
    font-size: 0.68rem;
    color: var(--color-empress-base);
    text-transform: uppercase;
    letter-spacing: 0.1em;

    > *,
    time {
      font-family: inherit;
    }

    > span:not(.category-label) {
      display: inline-flex;
      gap: 0.45em;
    }
  }

  .category-label {
    color: var(--color-empress-dark-2);
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 14px;
    padding: 0;
    margin: 18px 0 0;
    font-family: var(--font-kiyosuna-sans);
    font-size: 0.75rem;
    color: var(--color-empress-base);
    list-style: none;

    li::before {
      content: "#";
    }
  }

  .related-works {
    padding-top: 48px;

    > h2 {
      padding-bottom: 12px;
      margin-bottom: 20px;
      font-family: var(--font-kiyosuna-sans);
      font-size: 1.25rem;
      font-weight: 700;
      color: var(--color-empress-dark-2);
      border-bottom: 1px solid var(--color-dessert-dark-2);
    }
  }

  .note-navigation {
    display: grid;
    gap: 32px;
    padding-top: 32px;
    margin-top: 48px;
    border-top: 1px solid var(--color-dessert-dark-2);

    a {
      display: grid;
      gap: 4px;
      min-width: 0;
      color: var(--color-text);
      text-decoration: none;

      .navigation-label {
        display: inline-flex;
        gap: 0.35em;
        align-items: center;
        font-family: var(--font-suse-mono);
        font-size: 0.65rem;
        color: var(--color-empress-base);
        text-transform: uppercase;
        letter-spacing: 0.1em;
      }

      strong {
        overflow: hidden;
        text-overflow: ellipsis;
        font-size: 0.88rem;
        font-weight: 300;
        white-space: nowrap;
      }

      &:is(:hover, :focus-visible) strong {
        text-decoration: underline;
        text-underline-offset: 0.2em;
      }
    }
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    white-space: nowrap;
    border: 0;
    clip-path: inset(50%);
  }

  @media (width >= 680px) {
    .note-detail {
      padding-bottom: 96px;
    }

    .note-header {
      margin-top: 56px;
    }

    .note-meta {
      font-size: 0.75rem;
    }

    .tag-list {
      font-size: 0.875rem;
    }

    .note-navigation {
      grid-template-columns: repeat(2, minmax(0, 1fr));

      .older-note {
        text-align: right;

        .navigation-label {
          justify-content: end;
        }

        strong {
          text-align: end;
        }
      }
    }
  }
</style>

<style is:global>
  .note-body {
    padding-top: 40px;
    margin-top: 40px;
    font-size: 0.98rem;
    line-height: 1.95;
    color: var(--color-text);
    border-top: 1px solid var(--color-dessert-dark-2);
  }

  .note-body > :first-child {
    margin-top: 0;
  }

  .note-body p {
    margin-block: 0 22px;
  }

  .note-body :is(h2, h3, h4) {
    position: relative;
    margin-block: 52px 18px;
    font-family: var(--font-kiyosuna-sans);
    font-weight: 700;
    line-height: 1.4;
    color: var(--color-empress-dark-2);
  }

  .note-body h2 {
    font-size: 1.7rem;
  }

  .note-body h3 {
    font-size: 1.35rem;
  }

  .note-body h4 {
    font-size: 1.1rem;
  }

  .note-body .heading-anchor {
    position: absolute;
    top: 0;
    right: 100%;
    padding-right: 0.35em;
    font-family: var(--font-suse-mono);
    font-weight: 300;
    color: var(--color-empress-light-1);
    text-decoration: none;
    opacity: 0;
    transition: opacity 0.15s ease-out;
  }

  .note-body .heading-anchor:focus-visible,
  .note-body :is(h2, h3, h4):hover .heading-anchor {
    opacity: 1;
  }

  .note-body a {
    color: var(--color-empress-dark-1);
    text-underline-offset: 0.2em;
  }

  .note-body :is(ul, ol) {
    padding-inline-start: 1.5em;
    margin-block: 0 22px;
  }

  .note-body li + li {
    margin-top: 0.35em;
  }

  .note-body blockquote {
    padding-left: 18px;
    margin-block: 28px;
    color: var(--color-empress-dark-1);
    border-left: 2px solid var(--color-dessert-dark-3);
  }

  .note-body img {
    height: auto;
    margin-block: 32px;
  }

  .note-body figcaption {
    margin-top: 8px;
    font-size: 0.8rem;
    line-height: 1.6;
    color: var(--color-empress-base);
  }

  .note-body :not(pre) > code {
    padding: 0.12em 0.36em;
    font-family: var(--font-suse-mono);
    font-size: 0.88em;
    background: var(--color-dessert-dark-1);
  }

  .note-body pre {
    position: relative;
    padding: 22px;
    margin-block: 28px;
    overflow-x: auto;
    line-height: 1.75;
    background: var(--color-surface) !important;
    border: 1px solid var(--color-dessert-dark-2);
  }

  .note-body pre code,
  .note-body pre code span {
    font-family: var(--font-suse-mono);
    font-size: 0.84rem;
  }

  .note-body .code-copy-button {
    position: absolute;
    top: 8px;
    right: 8px;
    display: grid;
    width: 32px;
    height: 32px;
    padding: 7px;
    color: var(--color-empress-dark-1);
    cursor: pointer;
    background: color-mix(in srgb, var(--color-surface) 88%, transparent);
    border: 1px solid var(--color-dessert-dark-2);
    opacity: 0;
    transition:
      color 0.15s ease-out,
      opacity 0.15s ease-out;
  }

  .note-body .code-copy-button:is(:hover, :focus-visible) {
    color: var(--color-text);
  }

  .note-body .code-copy-button:focus-visible,
  .note-body pre:focus-within .code-copy-button,
  .note-body pre:hover .code-copy-button {
    opacity: 1;
  }

  .note-body .code-copy-button svg {
    grid-area: 1 / 1;
    width: 100%;
    height: 100%;
    fill: none;
    stroke: currentcolor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .note-body .check-icon,
  .note-body .code-copy-button[data-copied] .copy-icon {
    opacity: 0;
  }

  .note-body .code-copy-button[data-copied] .check-icon {
    opacity: 1;
  }

  .note-body table {
    display: block;
    width: max-content;
    max-width: 100%;
    margin-block: 28px;
    overflow-x: auto;
    border-collapse: collapse;
  }

  .note-body :is(th, td) {
    padding: 10px 14px;
    text-align: left;
    border: 1px solid var(--color-dessert-dark-2);
  }

  .note-body th {
    font-weight: 700;
    background: var(--color-dessert-dark-1);
  }

  .note-body hr {
    margin-block: 40px;
    border: 0;
    border-top: 1px solid var(--color-dessert-dark-2);
  }

  @media (hover: none), (pointer: coarse) {
    .note-body .code-copy-button {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .note-body :is(.heading-anchor, .code-copy-button) {
      transition: none;
    }
  }

  @media (width >= 680px) {
    .note-body {
      padding-top: 48px;
      margin-top: 48px;
      font-size: 1.02rem;
    }
  }
</style>
