---
import "../styles/globals.css";

const primitiveTokens = [
  {
    name: "--color-empress-light-1",
    value: "#999092",
    family: "Empress",
    step: "Light 1",
  },
  {
    name: "--color-empress-base",
    value: "#7f7678",
    family: "Empress",
    step: "Base",
  },
  {
    name: "--color-empress-dark-1",
    value: "#6c6465",
    family: "Empress",
    step: "Dark 1",
  },
  {
    name: "--color-empress-dark-2",
    value: "#595153",
    family: "Empress",
    step: "Dark 2",
  },
  {
    name: "--color-dessert-base",
    value: "#f7f7f4",
    family: "Dessert",
    step: "Base",
  },
  {
    name: "--color-dessert-dark-1",
    value: "#e4e4df",
    family: "Dessert",
    step: "Dark 1",
  },
  {
    name: "--color-dessert-dark-2",
    value: "#d0d0ca",
    family: "Dessert",
    step: "Dark 2",
  },
  {
    name: "--color-dessert-dark-3",
    value: "#b7b7af",
    family: "Dessert",
    step: "Dark 3",
  },
];

const semanticTokens = [
  {
    name: "--color-background",
    value: "var(--color-dessert-base)",
    label: "Background",
    description: "ページ全体の背景",
  },
  {
    name: "--color-surface",
    value: "#fff",
    label: "Surface",
    description: "カードや入力欄の面",
  },
  {
    name: "--color-text",
    value: "#0f090b",
    label: "Text",
    description: "本文と見出し",
  },
  {
    name: "--color-primary",
    value: "var(--color-empress-dark-1)",
    label: "Primary",
    description: "主要な操作や強調",
  },
  {
    name: "--color-primary-hover",
    value: "var(--color-empress-dark-2)",
    label: "Primary hover",
    description: "主要な操作のホバー時",
  },
  {
    name: "--color-border",
    value: "var(--color-empress-dark-2)",
    label: "Border",
    description: "要素の境界線",
  },
];
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="globals.css で定義しているカラートークンの確認ページ"
    />
    <title>Color tokens</title>
  </head>
  <body>
    <main>
      <header class="page-header">
        <p class="eyebrow">Design system / Colors</p>
        <h1>Color tokens</h1>
        <p class="introduction">
          <code>src/styles/globals.css</code>
          で定義している色と、実際のUIでの組み合わせを確認するためのページです。
        </p>
      </header>

      <section class="section" aria-labelledby="primitive-heading">
        <div class="section-heading">
          <div>
            <p class="section-number" aria-hidden="true">01</p>
            <h2 id="primitive-heading">Primitive tokens</h2>
          </div>
          <p>色そのものを表す、ほかのトークンの基礎となる値です。</p>
        </div>

        <div class="palette-grid">
          {
            primitiveTokens.map((token) => (
              <article class="token-card">
                <div
                  class="swatch"
                  style={`--swatch-color: var(${token.name})`}
                  aria-hidden="true"
                />
                <div class="token-content">
                  <div class="token-label">
                    <p>{token.family}</p>
                    <span>{token.step}</span>
                  </div>
                  <code>{token.name}</code>
                  <p class="token-value">{token.value}</p>
                </div>
              </article>
            ))
          }
        </div>
      </section>

      <section class="section" aria-labelledby="semantic-heading">
        <div class="section-heading">
          <div>
            <p class="section-number" aria-hidden="true">02</p>
            <h2 id="semantic-heading">Semantic tokens</h2>
          </div>
          <p>UI上の役割を表すトークンです。左端は現在解決される色です。</p>
        </div>

        <div class="semantic-list">
          {
            semanticTokens.map((token) => (
              <article class="semantic-row">
                <span
                  class="semantic-swatch"
                  style={`--swatch-color: var(${token.name})`}
                  aria-hidden="true"
                />
                <div class="semantic-name">
                  <p>{token.label}</p>
                  <span>{token.description}</span>
                </div>
                <code>{token.name}</code>
                <code class="semantic-value">{token.value}</code>
              </article>
            ))
          }
        </div>
      </section>

      <section class="section" aria-labelledby="examples-heading">
        <div class="section-heading">
          <div>
            <p class="section-number" aria-hidden="true">03</p>
            <h2 id="examples-heading">UI examples</h2>
          </div>
          <p>semantic token を実際の要素に適用したときの見え方です。</p>
        </div>

        <div class="example-grid">
          <article class="preview-card">
            <p class="preview-label">Surface / Text / Border</p>
            <h3>静かな午後の読みもの</h3>
            <p class="preview-copy">
              背景と面、文字、境界線の関係をまとめて確認できます。小さな文字でも読みやすいかを見てください。
            </p>
            <a class="text-link" href="#primitive-heading">色の内訳を見る</a>
          </article>

          <article class="preview-card">
            <p class="preview-label">Primary / Primary hover</p>
            <h3>Action states</h3>
            <p class="preview-copy">
              ポインターを重ねるか、Tabキーでフォーカスして状態の違いを確認できます。
            </p>
            <div class="button-row">
              <button class="primary-button" type="button"
                >Primary action</button
              >
              <button class="secondary-button" type="button">
                Secondary
              </button>
            </div>
          </article>

          <article class="preview-card form-preview">
            <p class="preview-label">Form controls</p>
            <h3>連絡先</h3>
            <label for="token-preview-email">メールアドレス</label>
            <input
              id="token-preview-email"
              type="email"
              placeholder="hello@example.com"
            />
            <p class="field-note">Surface、Text、Border を使用しています。</p>
          </article>

          <article class="preview-card status-preview">
            <p class="preview-label">Tone comparison</p>
            <h3>Empress scale</h3>
            <div class="tone-bars">
              <span class="tone-light">Light 1</span>
              <span class="tone-base">Base</span>
              <span class="tone-dark-1">Dark 1</span>
              <span class="tone-dark-2">Dark 2</span>
            </div>
          </article>
        </div>
      </section>
    </main>
  </body>
</html>

<style is:global>
  * {
    box-sizing: border-box;
  }

  html {
    min-width: 320px;
    font-family:
      Inter, "Helvetica Neue", "Hiragino Sans", "Yu Gothic", Meiryo, sans-serif;
    color: var(--color-text);
    background: var(--color-background);
  }

  body {
    min-height: 100vh;
    margin: 0;
  }

  button,
  input {
    font: inherit;
  }

  main {
    width: min(100% - 40px, 1120px);
    padding-block: 72px 120px;
    margin-inline: auto;
  }

  .page-header {
    max-width: 760px;
    margin-bottom: 88px;
  }

  .eyebrow,
  .section-number,
  .preview-label {
    margin: 0;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-primary-hover);
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  h1 {
    margin: 12px 0 24px;
    font-size: clamp(3rem, 10vw, 7rem);
    font-weight: 500;
    line-height: 0.9;
    letter-spacing: -0.065em;
  }

  .introduction {
    max-width: 680px;
    margin: 0;
    font-size: clamp(1rem, 2vw, 1.25rem);
    line-height: 1.8;
  }

  code {
    font-family: SFMono-Regular, Consolas, "Liberation Mono", monospace;
    font-size: 0.78rem;
    overflow-wrap: anywhere;
  }

  .introduction code {
    padding: 0.2em 0.45em;
    background: var(--color-dessert-dark-1);
    border-radius: 4px;
  }

  .section + .section {
    margin-top: 96px;
  }

  .section-heading {
    display: grid;
    grid-template-columns: minmax(240px, 1fr) 1fr;
    gap: 32px;
    align-items: end;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--color-border);
  }

  .section-heading h2 {
    margin: 6px 0 0;
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    font-weight: 500;
    letter-spacing: -0.04em;
  }

  .section-heading > p {
    max-width: 480px;
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.7;
  }

  .palette-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
    margin-top: 24px;
  }

  .token-card,
  .preview-card {
    background: var(--color-surface);
    border: 1px solid var(--color-dessert-dark-2);
  }

  .token-card {
    min-width: 0;
  }

  .swatch {
    aspect-ratio: 4 / 3;
    background: var(--swatch-color);
    border-bottom: 1px solid var(--color-dessert-dark-2);
  }

  .token-content {
    padding: 18px;
  }

  .token-label {
    display: flex;
    gap: 12px;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 24px;
  }

  .token-label p,
  .semantic-name p {
    margin: 0;
    font-weight: 700;
  }

  .token-label span,
  .semantic-name span,
  .token-value,
  .field-note {
    font-size: 0.78rem;
    color: var(--color-empress-dark-1);
  }

  .token-value {
    margin: 6px 0 0;
    font-family: SFMono-Regular, Consolas, "Liberation Mono", monospace;
    text-transform: uppercase;
  }

  .semantic-list {
    margin-top: 24px;
    background: var(--color-surface);
    border: 1px solid var(--color-dessert-dark-2);
  }

  .semantic-row {
    display: grid;
    grid-template-columns: 48px minmax(160px, 1fr) minmax(220px, 1fr) minmax(
        220px,
        1fr
      );
    gap: 24px;
    align-items: center;
    min-height: 84px;
    padding: 16px 24px;
  }

  .semantic-row + .semantic-row {
    border-top: 1px solid var(--color-dessert-dark-2);
  }

  .semantic-swatch {
    width: 48px;
    height: 48px;
    background: var(--swatch-color);
    border: 1px solid var(--color-dessert-dark-2);
    border-radius: 50%;
  }

  .semantic-name span {
    display: block;
    margin-top: 4px;
  }

  .semantic-value {
    color: var(--color-empress-dark-1);
  }

  .example-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    margin-top: 24px;
  }

  .preview-card {
    min-height: 300px;
    padding: clamp(24px, 4vw, 40px);
  }

  .preview-card h3 {
    margin: 48px 0 12px;
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 500;
    letter-spacing: -0.035em;
  }

  .preview-copy {
    max-width: 32em;
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.8;
  }

  .text-link {
    display: inline-block;
    margin-top: 24px;
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--color-primary-hover);
    text-underline-offset: 4px;
  }

  .text-link:hover {
    color: var(--color-primary);
  }

  .button-row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }

  .primary-button,
  .secondary-button {
    min-height: 44px;
    padding: 10px 18px;
    cursor: pointer;
    border: 1px solid var(--color-border);
    border-radius: 4px;
  }

  .primary-button {
    color: var(--color-surface);
    background: var(--color-primary);
  }

  .primary-button:hover,
  .primary-button:focus-visible {
    background: var(--color-primary-hover);
  }

  .secondary-button {
    color: var(--color-text);
    background: var(--color-surface);
  }

  .secondary-button:hover,
  .secondary-button:focus-visible {
    background: var(--color-background);
  }

  .primary-button:focus-visible,
  .secondary-button:focus-visible,
  input:focus-visible,
  .text-link:focus-visible {
    outline: 3px solid var(--color-dessert-dark-3);
    outline-offset: 3px;
  }

  .form-preview label {
    display: block;
    margin: 28px 0 8px;
    font-size: 0.85rem;
    font-weight: 700;
  }

  .form-preview input {
    width: 100%;
    min-height: 48px;
    padding: 10px 12px;
    color: var(--color-text);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 4px;
  }

  .form-preview input::placeholder {
    color: var(--color-empress-light-1);
  }

  .field-note {
    margin: 8px 0 0;
  }

  .tone-bars {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    min-height: 128px;
    margin-top: 28px;
  }

  .tone-bars span {
    display: flex;
    align-items: flex-end;
    padding: 10px;
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--color-surface);
  }

  .tone-light {
    background: var(--color-empress-light-1);
  }

  .tone-base {
    background: var(--color-empress-base);
  }

  .tone-dark-1 {
    background: var(--color-empress-dark-1);
  }

  .tone-dark-2 {
    background: var(--color-empress-dark-2);
  }

  @media (width <= 840px) {
    main {
      padding-block: 48px 80px;
    }

    .page-header {
      margin-bottom: 64px;
    }

    .palette-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .semantic-row {
      grid-template-columns: 48px minmax(0, 1fr) minmax(0, 1.4fr);
    }

    .semantic-value {
      display: none;
    }
  }

  @media (width <= 600px) {
    main {
      width: min(100% - 24px, 1120px);
    }

    .section + .section {
      margin-top: 72px;
    }

    .section-heading {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .palette-grid,
    .example-grid {
      grid-template-columns: 1fr;
    }

    .swatch {
      aspect-ratio: 2 / 1;
    }

    .semantic-row {
      grid-template-columns: 40px minmax(0, 1fr);
      gap: 16px;
      padding: 16px;
    }

    .semantic-swatch {
      width: 40px;
      height: 40px;
    }

    .semantic-row > code {
      grid-column: 2;
    }

    .preview-card {
      min-height: 0;
    }

    .preview-card h3 {
      margin-top: 36px;
    }
  }
</style>
