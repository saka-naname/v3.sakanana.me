---
import "../../styles/globals.css";

import { Font } from "astro:assets";
import { getCollection } from "astro:content";

import FeaturedWorkCard from "../../components/works/FeaturedWorkCard.astro";
import { kindLabels } from "../../components/works/work-card";
import WorkCard from "../../components/works/WorkCard.astro";
import Layout from "../../layouts/Layout.astro";

const kindOrder = ["software", "illustration", "music", "other"] as const;

const works = (await getCollection("work", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
);
const workById = new Map(works.map((work) => [work.id, work]));
const [worksCuration] = await getCollection("worksCuration");
const featuredWorks = (worksCuration?.data.featured ?? [])
  .flatMap(({ id }) => {
    const work = workById.get(id);
    return work ? [work] : [];
  })
  .slice(0, 3);
const availableKinds = kindOrder.filter((kind) =>
  works.some(({ data }) => data.kind === kind),
);
---

<head>
  <meta charset="utf-8" />
  <Font cssVariable="--font-kiyosuna-sans" />
  <Font cssVariable="--font-suse-mono" />
</head>

<Layout
  title="Works | sakanana.me"
  description="saka-naname の制作物一覧です。"
>
  <main class="works-page">
    <div class="heading-row">
      <h1>WORKS</h1>
    </div>

    {
      featuredWorks.length > 0 && (
        <section class="featured" aria-labelledby="featured-title">
          <div class="section-heading">
            <h2 id="featured-title">FEATURED</h2>
          </div>

          <div
            class="featured-carousel"
            data-featured-carousel
            role="group"
            aria-roledescription="カルーセル"
            aria-label="注目作品"
            tabindex="0"
          >
            <div class="featured-list">
              {featuredWorks.map((work, index) => (
                <FeaturedWorkCard
                  work={work}
                  variant={index === 0 ? "card" : "list"}
                  slideIndex={index}
                  slideCount={featuredWorks.length}
                />
              ))}
            </div>
          </div>

          <div class="carousel-controls" data-carousel-controls>
            <p aria-live="off">
              <span data-carousel-current>01</span>
              <span aria-hidden="true"> / </span>
              <span class="visually-hidden">全</span>
              <span>{String(featuredWorks.length).padStart(2, "0")}</span>
            </p>
            <div>
              <button
                class="carousel-button"
                type="button"
                data-carousel-toggle
                aria-label="自動再生を停止"
              >
                <span data-carousel-toggle-icon aria-hidden="true">
                  Ⅱ
                </span>
              </button>
              <button
                class="carousel-button"
                type="button"
                data-carousel-previous
                aria-label="前の作品を見る"
              >
                <span aria-hidden="true">←</span>
              </button>
              <button
                class="carousel-button"
                type="button"
                data-carousel-next
                aria-label="次の作品を見る"
              >
                <span aria-hidden="true">→</span>
              </button>
            </div>
          </div>
        </section>
      )
    }

    <section class="archive" aria-labelledby="archive-title">
      <div class="section-heading archive-heading">
        <h2 id="archive-title">ALL WORKS</h2>
      </div>

      <div class="filter-row" role="group" aria-label="作品を種類で絞り込む">
        <button
          class="filter-button"
          type="button"
          data-filter="all"
          aria-pressed="true">All</button
        >
        {
          availableKinds.map((kind) => (
            <button
              class="filter-button"
              type="button"
              data-filter={kind}
              aria-pressed="false"
            >
              {kindLabels[kind]}
            </button>
          ))
        }
      </div>

      <div class="work-grid" data-work-grid>
        {works.map((work) => <WorkCard work={work} />)}
      </div>

      <p class="empty-state" data-empty-state hidden>
        このカテゴリーの作品はまだありません。
      </p>
    </section>
  </main>
</Layout>

<script>
  import EmblaCarousel from "embla-carousel";
  import Autoplay from "embla-carousel-autoplay";

  const filterButtons = Array.from(
    document.querySelectorAll<HTMLButtonElement>("[data-filter]"),
  );
  const workCards = Array.from(
    document.querySelectorAll<HTMLElement>("[data-work-kind]"),
  );
  const resultCount = document.querySelector<HTMLElement>(
    "[data-result-count]",
  );
  const emptyState = document.querySelector<HTMLElement>("[data-empty-state]");

  filterButtons.forEach((button) => {
    button.addEventListener("click", () => {
      const selectedKind = button.dataset.filter;
      let visibleCount = 0;

      filterButtons.forEach((item) => {
        item.setAttribute(
          "aria-pressed",
          String(item.dataset.filter === selectedKind),
        );
      });

      workCards.forEach((card) => {
        const isVisible =
          selectedKind === "all" || card.dataset.workKind === selectedKind;
        card.hidden = !isVisible;
        if (isVisible) visibleCount += 1;
      });

      if (resultCount) resultCount.textContent = String(visibleCount);
      if (emptyState) emptyState.hidden = visibleCount !== 0;
    });
  });

  const carousel = document.querySelector<HTMLElement>(
    "[data-featured-carousel]",
  );
  const currentNumber = document.querySelector<HTMLElement>(
    "[data-carousel-current]",
  );
  const previousButton = document.querySelector<HTMLButtonElement>(
    "[data-carousel-previous]",
  );
  const nextButton = document.querySelector<HTMLButtonElement>(
    "[data-carousel-next]",
  );
  const autoplayButton = document.querySelector<HTMLButtonElement>(
    "[data-carousel-toggle]",
  );
  const autoplayIcon = document.querySelector<HTMLElement>(
    "[data-carousel-toggle-icon]",
  );

  if (carousel) {
    const prefersReducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;
    const autoplay = Autoplay({
      delay: 5000,
      playOnInit: !prefersReducedMotion,
      stopOnFocusIn: true,
      stopOnInteraction: false,
      stopOnMouseEnter: true,
      breakpoints: {
        "(min-width: 768px)": { active: false },
      },
    });
    const embla = EmblaCarousel(
      carousel,
      {
        align: "start",
        loop: true,
        duration: 28,
        breakpoints: {
          "(min-width: 768px)": { active: false },
          "(prefers-reduced-motion: reduce)": { duration: 0 },
        },
      },
      [autoplay],
    );

    carousel.dataset.carouselReady = "true";

    const updateCarousel = () => {
      if (currentNumber) {
        currentNumber.textContent = String(
          embla.selectedScrollSnap() + 1,
        ).padStart(2, "0");
      }
      if (previousButton) previousButton.disabled = !embla.canScrollPrev();
      if (nextButton) nextButton.disabled = !embla.canScrollNext();
    };

    const updateAutoplayButton = () => {
      const isPlaying = autoplay.isPlaying();
      if (autoplayButton) {
        autoplayButton.setAttribute(
          "aria-label",
          isPlaying ? "自動再生を停止" : "自動再生を開始",
        );
      }
      if (autoplayIcon) autoplayIcon.textContent = isPlaying ? "Ⅱ" : "▶";
    };

    previousButton?.addEventListener("click", () => {
      embla.scrollPrev();
      autoplay.reset();
    });
    nextButton?.addEventListener("click", () => {
      embla.scrollNext();
      autoplay.reset();
    });
    autoplayButton?.addEventListener("click", () => {
      if (autoplay.isPlaying()) autoplay.stop();
      else autoplay.play();
      updateAutoplayButton();
    });

    embla
      .on("select", updateCarousel)
      .on("reInit", updateCarousel)
      .on("autoplay:play", updateAutoplayButton)
      .on("autoplay:stop", updateAutoplayButton);

    updateCarousel();
    updateAutoplayButton();
  }
</script>

<style>
  .works-page {
    width: var(--container);
    min-height: 100lvh;
    margin-inline: auto;
    color: var(--color-text);
  }

  .section-heading p,
  .carousel-controls,
  .filter-row button {
    font-family: var(--font-suse-mono);
  }

  .heading-row h1,
  .section-heading h2 {
    font-family: var(--font-kiyosuna-sans);
  }

  .heading-row h1 {
    padding-bottom: 4px;
    margin-bottom: 12px;
    font-family: var(--font-kiyosuna-sans);
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--color-empress-dark-2);
  }

  .featured,
  .archive {
    padding-bottom: 72px;
  }

  .section-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding-bottom: 12px;
    margin-bottom: 24px;
    border-bottom: 1px solid var(--color-dessert-dark-2);
  }

  .section-heading h2 {
    font-size: 1.45rem;
    font-weight: 700;
    color: var(--color-empress-dark-2);
  }

  .section-heading span,
  .section-heading p {
    font-size: 0.68rem;
    color: var(--color-empress-base);
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  .featured-carousel {
    overflow-x: auto;
    scroll-behavior: smooth;
    overscroll-behavior-inline: contain;
    scroll-snap-type: inline mandatory;
    scrollbar-width: none;

    &::-webkit-scrollbar {
      display: none;
    }
  }

  .featured-carousel[data-carousel-ready="true"] {
    overflow: hidden;
    scroll-behavior: auto;
    scroll-snap-type: none;
  }

  .featured-list {
    display: flex;
    gap: 16px;
    touch-action: pan-y pinch-zoom;
  }

  .carousel-controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 16px;
    font-size: 0.72rem;
    color: var(--color-empress-dark-1);
    letter-spacing: 0.08em;
  }

  .carousel-controls > div {
    display: flex;
    border: 1px solid var(--color-dessert-dark-2);
  }

  .carousel-button {
    display: grid;
    place-items: center;
    width: 44px;
    height: 38px;
    padding: 0;
    color: var(--color-empress-dark-2);
    cursor: pointer;
    background: transparent;
    border: 0;

    &:is(:hover, :focus-visible) {
      color: var(--color-background);
      background: var(--color-empress-dark-2);
    }

    &:disabled {
      color: var(--color-dessert-dark-3);
      cursor: default;
      background: transparent;
    }
  }

  .carousel-button + .carousel-button {
    border-left: 1px solid var(--color-dessert-dark-2);
  }

  .archive-heading {
    margin-bottom: 0;
  }

  .filter-row {
    display: flex;
    gap: 18px;
    padding-block: 18px 16px;
    margin-bottom: 32px;
    overflow-x: auto;
    white-space: nowrap;
    scrollbar-width: none;

    &::-webkit-scrollbar {
      display: none;
    }
  }

  .filter-button {
    position: relative;
    flex: none;
    padding: 0 0 5px;
    font-size: 0.75rem;
    color: var(--color-empress-light-1);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    cursor: pointer;
    background: transparent;
    border: 0;

    &::after {
      position: absolute;
      right: 0;
      bottom: 0;
      left: 0;
      height: 1px;
      content: "";
      background: currentcolor;
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 0.2s ease-out;
    }

    &:is(:hover, :focus-visible),
    &[aria-pressed="true"] {
      color: var(--color-empress-dark-2);
    }

    &[aria-pressed="true"]::after {
      transform: scaleX(1);
    }
  }

  .work-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 48px 24px;
  }

  .empty-state {
    padding: 64px 24px;
    color: var(--color-empress-dark-1);
    text-align: center;
    border-top: 1px solid var(--color-dessert-dark-2);
    border-bottom: 1px solid var(--color-dessert-dark-2);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    white-space: nowrap;
    border: 0;
    clip-path: inset(50%);
  }

  @media (width >= 680px) {
    .work-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .filter-row {
      gap: 24px;
    }
  }

  @media (width >= 768px) {
    .heading-row h1 {
      font-size: 3rem;
    }

    .featured-carousel,
    .featured-carousel[data-carousel-ready="true"] {
      overflow: visible;
      scroll-snap-type: none;
    }

    .featured-list {
      display: grid;
      grid-template-rows: repeat(2, minmax(0, 1fr));
      grid-template-columns: minmax(0, 1.45fr) minmax(270px, 0.75fr);
      gap: 28px 40px;
    }

    .carousel-controls {
      display: none;
    }

    .featured,
    .archive {
      padding-bottom: 72px;
    }

    .filter-button {
      font-size: 0.9rem;
    }
  }

  @media (width >= 1080px) {
    .work-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 56px 32px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .featured-carousel {
      scroll-behavior: auto;
    }
  }
</style>
