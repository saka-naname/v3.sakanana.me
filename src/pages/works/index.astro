---
import "../../styles/globals.css";

import { getCollection } from "astro:content";

import FeaturedWorkCard from "../../components/works/FeaturedWorkCard.astro";
import { kindLabels } from "../../components/works/work-card";
import WorkCard from "../../components/works/WorkCard.astro";
import Layout from "../../layouts/Layout.astro";
import { isPublicContentEntry } from "../../utils/content";

const kindOrder = ["development", "illustration", "music", "other"] as const;

const allWorks = await getCollection("work");
const works = allWorks
  .filter(isPublicContentEntry)
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());
const workById = new Map(allWorks.map((work) => [work.id, work]));
const [worksCuration] = await getCollection("worksCuration");
const featuredWorks = (worksCuration?.data.featured ?? [])
  .map(({ id }) => {
    const work = workById.get(id);
    if (!work) {
      throw new Error(`Featured work not found: ${id}`);
    }

    return work;
  })
  .filter(isPublicContentEntry)
  .slice(0, 4);
const featuredGhosts = Array.from({
  length: Math.max(0, 4 - featuredWorks.length),
});
const availableKinds = kindOrder.filter((kind) =>
  works.some(({ data }) => data.kind === kind),
);
---

<Layout title="Works | sakanana.me">
  <main class="works-page">
    <div class="heading-row">
      <h1>WORKS</h1>
    </div>

    {
      featuredWorks.length > 0 && (
        <section class="featured" aria-labelledby="featured-title">
          <div class="section-heading">
            <h2 id="featured-title">FEATURED</h2>
          </div>

          <div class="featured-carousel-frame">
            <div
              class="featured-carousel"
              data-featured-carousel
              role="group"
              aria-roledescription="カルーセル"
              aria-label="注目作品"
              tabindex="0"
            >
              <div class="featured-list" data-featured-list>
                {featuredWorks.map((work, index) => (
                  <FeaturedWorkCard
                    work={work}
                    variant={index === 0 ? "card" : "list"}
                    slideIndex={index}
                    slideCount={featuredWorks.length}
                  />
                ))}
                {featuredGhosts.map(() => (
                  <div class="featured-ghost" aria-hidden="true" />
                ))}
              </div>
            </div>
          </div>

          <div class="carousel-indicators" aria-hidden="true">
            {featuredWorks.map((_, index) => (
              <span
                class="carousel-indicator"
                data-carousel-indicator
                data-active={index === 0 ? "true" : undefined}
              />
            ))}
          </div>
        </section>
      )
    }

    <section class="archive" aria-labelledby="archive-title">
      <div class="section-heading archive-heading">
        <h2 id="archive-title">ALL WORKS</h2>

        <div class="filter-row" role="group" aria-label="作品を種類で絞り込む">
          <button
            class="filter-button"
            type="button"
            data-filter="all"
            aria-pressed="true">All</button
          >
          {
            availableKinds.map((kind) => (
              <button
                class="filter-button"
                type="button"
                data-filter={kind}
                aria-pressed="false"
              >
                {kindLabels[kind]}
              </button>
            ))
          }
        </div>
      </div>

      <div class="work-grid" data-work-grid>
        {
          works.map((work, index) => (
            <WorkCard work={work} loading={index < 3 ? "eager" : "lazy"} />
          ))
        }
      </div>

      <p class="empty-state" data-empty-state hidden>
        このカテゴリーの作品はまだありません。
      </p>
    </section>
  </main>
</Layout>

<script>
  import EmblaCarousel from "embla-carousel";
  import Autoplay from "embla-carousel-autoplay";

  const filterButtons = Array.from(
    document.querySelectorAll<HTMLButtonElement>("[data-filter]"),
  );
  const workCards = Array.from(
    document.querySelectorAll<HTMLElement>("[data-work-kind]"),
  );
  const resultCount = document.querySelector<HTMLElement>(
    "[data-result-count]",
  );
  const emptyState = document.querySelector<HTMLElement>("[data-empty-state]");

  filterButtons.forEach((button) => {
    button.addEventListener("click", () => {
      const selectedKind = button.dataset.filter;
      let visibleCount = 0;

      filterButtons.forEach((item) => {
        item.setAttribute(
          "aria-pressed",
          String(item.dataset.filter === selectedKind),
        );
      });

      workCards.forEach((card) => {
        const isVisible =
          selectedKind === "all" || card.dataset.workKind === selectedKind;
        card.hidden = !isVisible;
        if (isVisible) visibleCount += 1;
      });

      if (resultCount) resultCount.textContent = String(visibleCount);
      if (emptyState) emptyState.hidden = visibleCount !== 0;
    });
  });

  const carousel = document.querySelector<HTMLElement>(
    "[data-featured-carousel]",
  );
  const featuredList = document.querySelector<HTMLElement>(
    "[data-featured-list]",
  );
  const indicators = Array.from(
    document.querySelectorAll<HTMLElement>("[data-carousel-indicator]"),
  );
  if (carousel) {
    const prefersReducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;
    const autoplay = Autoplay({
      delay: 5000,
      playOnInit: !prefersReducedMotion,
      stopOnFocusIn: true,
      stopOnInteraction: false,
      stopOnMouseEnter: true,
      breakpoints: {
        "(min-width: 960px)": { active: false },
      },
    });
    const embla = EmblaCarousel(
      carousel,
      {
        align: "start",
        loop: true,
        slides: "[data-featured-slide]",
        duration: 28,
        breakpoints: {
          "(min-width: 960px)": { active: false },
          "(prefers-reduced-motion: reduce)": { duration: 0 },
        },
      },
      [autoplay],
    );

    carousel.dataset.carouselReady = "true";

    const updateCarousel = () => {
      const selectedIndex = embla.selectedScrollSnap();
      indicators.forEach((indicator, index) => {
        indicator.toggleAttribute("data-active", index === selectedIndex);
      });
    };
    embla.on("select", updateCarousel).on("reInit", updateCarousel);

    updateCarousel();
  }

  if (carousel && featuredList) {
    const desktopLayout = window.matchMedia("(min-width: 960px)");
    const columnGap = 40;
    const secondaryMinWidth = 480;
    let layoutFrame = 0;

    const updateFeaturedLayout = () => {
      if (!desktopLayout.matches) {
        featuredList.style.removeProperty("--featured-primary-width");
        return;
      }

      const primaryCard =
        featuredList.querySelector<HTMLElement>(".variant-card");
      const primaryCopy =
        primaryCard?.querySelector<HTMLElement>(".featured-copy");
      const secondaryItems = Array.from(
        featuredList.querySelectorAll<HTMLElement>(
          ".variant-list, .featured-ghost",
        ),
      );
      if (!primaryCard || !primaryCopy || secondaryItems.length !== 3) return;

      const maxPrimaryWidth = Math.max(
        0,
        featuredList.clientWidth - columnGap - secondaryMinWidth,
      );
      let primaryWidth = maxPrimaryWidth;

      for (let index = 0; index < 16; index += 1) {
        featuredList.style.setProperty(
          "--featured-primary-width",
          `${primaryWidth}px`,
        );

        const firstSecondaryRect = secondaryItems[0].getBoundingClientRect();
        const lastSecondaryRect = secondaryItems
          .at(-1)
          ?.getBoundingClientRect();
        if (!lastSecondaryRect) return;

        const secondaryHeight =
          lastSecondaryRect.bottom - firstSecondaryRect.top;
        const targetPrimaryWidth = Math.min(
          maxPrimaryWidth,
          Math.max(0, secondaryHeight - primaryCopy.offsetHeight) * (4 / 3),
        );

        if (Math.abs(targetPrimaryWidth - primaryWidth) < 0.25) {
          primaryWidth = targetPrimaryWidth;
          break;
        }

        primaryWidth = (primaryWidth + targetPrimaryWidth) / 2;
      }

      featuredList.style.setProperty(
        "--featured-primary-width",
        `${primaryWidth}px`,
      );
    };

    const scheduleFeaturedLayout = () => {
      cancelAnimationFrame(layoutFrame);
      layoutFrame = requestAnimationFrame(updateFeaturedLayout);
    };

    new ResizeObserver(scheduleFeaturedLayout).observe(carousel);
    desktopLayout.addEventListener("change", scheduleFeaturedLayout);
    document.fonts.ready.then(scheduleFeaturedLayout);
    scheduleFeaturedLayout();
  }
</script>

<style>
  .works-page {
    width: var(--container);
    margin-inline: auto;
    color: var(--color-text);
  }

  .section-heading p,
  .filter-row button {
    font-family: var(--font-suse-mono);
  }

  .heading-row h1,
  .section-heading h2 {
    font-family: var(--font-kiyosuna-sans);
  }

  .heading-row h1 {
    padding-bottom: 4px;
    margin-bottom: 16px;
    font-family: var(--font-kiyosuna-sans);
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--color-empress-dark-2);
  }

  .featured {
    padding-bottom: 72px;
  }

  .section-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding-bottom: 12px;
    margin-bottom: 24px;
    border-bottom: 1px solid var(--color-dessert-dark-2);
  }

  .section-heading h2 {
    font-size: 1.45rem;
    font-weight: 700;
    color: var(--color-empress-dark-2);
  }

  .section-heading span,
  .section-heading p {
    font-size: 0.68rem;
    color: var(--color-empress-base);
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  .featured-carousel {
    overflow-x: auto;
    scroll-behavior: smooth;
    overscroll-behavior-inline: contain;
    scroll-snap-type: inline mandatory;
    scrollbar-width: none;

    &::-webkit-scrollbar {
      display: none;
    }
  }

  .featured-carousel-frame {
    position: relative;
    width: 100%;
    max-width: 640px;
    margin-inline: auto;
  }

  .featured-carousel[data-carousel-ready="true"] {
    overflow: hidden;
    scroll-behavior: auto;
    scroll-snap-type: none;
  }

  .featured-list {
    display: flex;
    gap: 16px;
    touch-action: pan-y pinch-zoom;
  }

  .featured-ghost {
    display: none;
  }

  .carousel-indicators {
    display: flex;
    gap: 8px;
    align-items: center;
    justify-content: center;
    margin-top: 16px;
  }

  .carousel-indicator {
    width: 7px;
    height: 7px;
    background: var(--color-dessert-dark-3);
    border-radius: 50%;
    transition:
      background-color 0.2s ease-out,
      transform 0.2s ease-out;

    &[data-active] {
      background: var(--color-empress-dark-2);
      transform: scale(1.25);
    }
  }

  .archive-heading {
    display: block;
    margin-bottom: 32px;
  }

  .filter-row {
    display: flex;
    gap: 18px;
    padding-top: 18px;
    overflow-x: auto;
    white-space: nowrap;
    scrollbar-width: none;

    &::-webkit-scrollbar {
      display: none;
    }
  }

  .filter-button {
    position: relative;
    flex: none;
    padding: 0 0 5px;
    font-size: 0.75rem;
    color: var(--color-empress-light-1);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    cursor: pointer;
    background: transparent;
    border: 0;

    &::after {
      position: absolute;
      right: 0;
      bottom: 0;
      left: 0;
      height: 1px;
      content: "";
      background: currentcolor;
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 0.2s ease-out;
    }

    &:is(:hover, :focus-visible),
    &[aria-pressed="true"] {
      color: var(--color-empress-dark-2);
    }

    &[aria-pressed="true"]::after {
      transform: scaleX(1);
    }
  }

  .work-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 48px 24px;
  }

  .empty-state {
    padding: 64px 24px;
    color: var(--color-empress-dark-1);
    text-align: center;
    border-bottom: 1px solid var(--color-dessert-dark-2);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    white-space: nowrap;
    border: 0;
    clip-path: inset(50%);
  }

  @media (width >= 680px) {
    .work-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .filter-row {
      gap: 24px;
    }
  }

  @media (width >= 768px) {
    .heading-row h1 {
      font-size: 3rem;
    }

    .featured {
      padding-bottom: 72px;
    }

    .filter-button {
      font-size: 0.9rem;
    }
  }

  @media (width >= 960px) {
    .featured-carousel-frame {
      max-width: none;
      margin-inline: 0;
    }

    .featured-carousel,
    .featured-carousel[data-carousel-ready="true"] {
      overflow: visible;
      scroll-snap-type: none;
    }

    .featured-list {
      --featured-list-card-height: calc(480px * 0.42 * 3 / 4);
      --featured-primary-width: calc(100% - 520px);

      display: grid;
      grid-template-rows: repeat(
        3,
        minmax(var(--featured-list-card-height), 1fr)
      );
      grid-template-columns:
        minmax(0, var(--featured-primary-width))
        minmax(480px, 1fr);
      gap: 28px 40px;
      touch-action: auto;
    }

    .featured-ghost {
      display: block;
      grid-column: 2;
      min-height: var(--featured-list-card-height);
      background: var(--color-dessert-dark-1);
      border: 1px solid var(--color-dessert-dark-2);
    }

    .carousel-indicators {
      display: none;
    }

    .work-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 56px 32px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .featured-carousel {
      scroll-behavior: auto;
    }
  }
</style>
