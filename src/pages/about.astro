---
import "../styles/globals.css";

import { Font } from "astro:assets";
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";

import avatarImage from "../assets/img/avatar.webp";
import Layout from "../layouts/Layout.astro";

const socialLinks: Array<{ label: string; href: string; icon: string }> = [
  {
    label: "GitHub プロフィールを見る",
    href: "https://github.com/saka-naname",
    icon: "hugeicons:github-01",
  },
  {
    label: "Bluesky プロフィールを見る",
    href: "https://bsky.app/profile/sakanana.me",
    icon: "hugeicons:bluesky",
  },
  {
    label: "X プロフィールを見る",
    href: "https://x.com/sakanana_me",
    icon: "hugeicons:new-twitter",
  },
];
---

<head>
  <meta charset="utf-8" />
  <Font cssVariable="--font-kiyosuna-sans" />
</head>

<Layout>
  <main class="container">
    <h1>PROFILE</h1>
    <div class="layout">
      <div class="avatar">
        <Image
          src={avatarImage}
          alt="アイコン"
          layout="full-width"
          class="icon"
          loading="eager"
        />
      </div>
      <div class="contents">
        <section id="profile">
          <div class="content">
            <h2 class="name">さか<span class="handle">saka-naname</span></h2>
            <p>学生ソフトウェアエンジニア。</p>
            <p>趣味としてお絵描きやDTM等の創作活動も嗜んでいます。</p>

            <ul class="social-links">
              {
                socialLinks.map(({ label, href, icon }) => (
                  <li>
                    <a href={href} aria-label={label}>
                      <Icon name={icon} aria-hidden="true" />
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </section>
        <section id="tools">
          <h2>作業環境・ツール</h2>
          <ul>
            <li>MacBook Air (M5)</li>
            <li>CLIP STUDIO PAINT</li>
            <li>Adobe Photoshop</li>
            <li>Studio One 6 Artist</li>
            <li>Bitwig Studio</li>
          </ul>
        </section>
        <section id="certifications">
          <h2>資格等</h2>
          <ul>
            <li>基本情報技術者 (2019年11月)</li>
          </ul>
        </section>
      </div>
    </div>
  </main>
</Layout>

<style>
  main {
    width: 100%;
    min-height: 100lvh;
  }

  section {
    width: 100%;
    padding-block: 16px;
  }

  .container {
    width: var(--container);
    margin-inline: auto;
  }

  h1 {
    padding-bottom: 4px;
    margin-bottom: 24px;
    font-family: var(--font-kiyosuna-sans);
    font-size: 2rem;
    font-weight: 700;
    color: var(--color-empress-dark-2);
    border-bottom: 2px solid var(--color-empress-dark-2);
  }

  .layout {
    display: flex;
    flex-direction: column;
  }

  .avatar {
    text-align: center;

    img {
      width: 240px;
      max-width: 80%;
      height: auto;
      aspect-ratio: 1;
      overflow: hidden;
      border: 2px solid var(--color-border);
      border-radius: 10%;
    }
  }

  #profile {
    .content {
      color: var(--color-empress-dark-2);

      .name {
        margin-bottom: 8px;
        font-family: var(--font-kiyosuna-sans);
        font-size: 2rem;
        font-weight: 700;

        .handle {
          margin-left: 0.5rem;
          font-family: var(--font-kiyosuna-sans);
          font-size: 0.6em;
          color: var(--color-empress-dark-1);
        }
      }

      .social-links {
        display: flex;
        gap: 16px;
        margin-top: 16px;

        a {
          display: grid;
          place-items: center;
          font-size: 1.75rem;
          color: var(--color-empress-light-1);

          &:is(:hover, :focus-visible) {
            color: var(--color-text);
          }
        }
      }
    }
  }

  #tools,
  #certifications {
    h2 {
      margin-bottom: 8px;
      font-family: var(--font-kiyosuna-sans);
      font-size: 1.5rem;
      font-weight: 700;
      color: var(--color-empress-dark-2);
    }

    ul {
      list-style: circle inside;
    }
  }

  @media (width >= 768px) {
    .layout {
      flex-direction: row;
      gap: 48px;
      width: fit-content;
      margin-inline: auto;
    }

    .avatar {
      text-align: start;

      img {
        width: 240px;
        max-width: none;
      }
    }
  }

  @media (width >= 1024px) {
    .avatar img {
      width: 360px;
    }

    .contents {
      width: 540px;
    }
  }
</style>
