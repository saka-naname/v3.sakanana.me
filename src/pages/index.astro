---
import "../styles/globals.css";

import Layout from "../layouts/Layout.astro";
---

<Layout headerVariant="top">
  <main>
    <section id="hero"></section>
    <section id="highlights"></section>
    <section id="about"></section>
  </main>
</Layout>

<style>
  main {
    width: 100%;
    min-height: 100lvh;
  }

  #hero {
    width: 100%;
    height: 100lvh;
    background-color: var(--color-dessert-dark-1);
  }
</style>
