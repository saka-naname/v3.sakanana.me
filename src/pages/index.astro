---
import "../styles/globals.css";

import { Font, Image } from "astro:assets";

import heroImage from "../assets/img/0004.png";
import Layout from "../layouts/Layout.astro";
---

<head>
  <meta charset="utf-8" />
  <Font cssVariable="--font-kiyosuna-sans" />
</head>

<Layout headerVariant="top">
  <main>
    <section id="hero">
      <Image
        src={heroImage}
        alt="コーヒーを淹れる代理のイラスト"
        class="hero-image"
        layout="full-width"
        loading="eager"
        fetchpriority="high"
      />
    </section>
    <section id="highlights">
      <h2 class="title">Highlights</h2>
    </section>
    <section id="about"></section>
  </main>
</Layout>

<style>
  main {
    width: 100%;
    min-height: 100lvh;
  }

  #hero {
    position: relative;
    width: 100vw;
    height: 100svh;
    overflow: hidden;
  }

  .hero-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 30% 35%;
  }

  .title {
    font-family: var(--font-kiyosuna-sans);
    color: var(--color-text);
  }

  #highlights {
    width: var(--container);
    height: 20vh;
    margin-inline: auto;
  }
</style>
