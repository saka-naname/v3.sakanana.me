---
import "../styles/globals.css";

import { Image } from "astro:assets";

import heroImage from "../assets/img/0004.png";
import Layout from "../layouts/Layout.astro";
---

<Layout headerVariant="top">
  <main>
    <section id="hero">
      <Image
        src={heroImage}
        alt="コーヒーを淹れる代理のイラスト"
        class="hero-image"
        layout="full-width"
        loading="eager"
        fetchpriority="high"
      />
    </section>
  </main>
</Layout>

<style>
  main {
    width: 100%;
    min-height: 100lvh;
  }

  section {
    width: 100%;
    padding-block: 1rem;

    .container {
      width: var(--container);
      margin-inline: auto;
    }
  }

  .coming-soon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 24rem;
    border: 2px solid var(--color-empress-dark-2);
    border-style: dashed;

    span {
      font-family: var(--font-kiyosuna-sans);
      font-size: 2rem;
      font-weight: 300;
    }
  }

  #hero {
    position: relative;
    width: 100vw;
    height: 100svh;
    overflow: hidden;
  }

  .hero-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 30% 35%;
  }

  .title {
    margin-bottom: 1rem;
    font-family: var(--font-kiyosuna-sans);
    font-size: 2rem;
    color: var(--color-text);
  }

  #highlights {
    margin-inline: auto;
  }
</style>
