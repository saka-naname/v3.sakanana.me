---
import "../styles/globals.css";

import { Image } from "astro:assets";

import heroImage from "../assets/img/0004.png";
import Layout from "../layouts/Layout.astro";
---

<Layout headerVariant="top">
  <main>
    <section id="hero">
      <Image
        src={heroImage}
        alt="コーヒーを淹れる代理のイラスト"
        class="hero-image"
        layout="full-width"
        loading="eager"
        fetchpriority="high"
      />
    </section>
    <section id="highlights"></section>
    <section id="about"></section>
  </main>
</Layout>

<style>
  main {
    width: 100%;
    min-height: 100lvh;
  }

  #hero {
    position: relative;
    width: 100vw;
    height: 100svh;
    overflow: hidden;
  }

  .hero-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 30% 35%;
  }
</style>
