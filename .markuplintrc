{
  "excludeFiles": [
    "dist/",
    "node_modules/"
  ],
  "specs": {
    "\\.[jt]sx?$": "@markuplint/react-spec"
  },
  "parser": {
    "\\.[jt]sx?$": "@markuplint/jsx-parser",
    "\\.astro$": "@markuplint/astro-parser"
  },
  "extends": [
    "markuplint:recommended"
  ],
  "nodeRules": [
    {
      "selector": "img",
      "rules": {
        "required-attr": "alt"
      }
    }
  ]
}
